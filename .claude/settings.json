{
  "_comment": "CLAVERA repo settings for cloud threads (user settings are not read in the cloud). Same owner deny list as on the Mac; hooks are repo-relative. Owner reserved: deletion, deploy/publish, secrets, money; pushes are limited by hooks/guard-bash.py to agent/* and claude/* branches (no force, no main or protected branches).",
  "permissions": {
    "defaultMode": "acceptEdits",
    "deny": [
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(trash:*)",
      "Bash(shred:*)",
      "Bash(git remote:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh release:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh secret:*)",
      "Bash(npm publish:*)",
      "Bash(yarn publish:*)",
      "Bash(pnpm publish:*)",
      "Bash(vercel:*)",
      "Bash(netlify:*)",
      "Bash(fly:*)",
      "Bash(wrangler:*)",
      "Bash(docker push:*)",
      "Bash(aws:*)",
      "Bash(gcloud:*)",
      "Bash(security:*)",
      "Bash(sudo:*)",
      "Bash(launchctl unload:*)",
      "Bash(launchctl remove:*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ],
    "allow": [
      "Bash(yarn:*)",
      "Bash(npx astro:*)",
      "Bash(node:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git worktree:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(sed:*)",
      "Bash(jq:*)",
      "Bash(wc:*)",
      "Bash(head:*)",
      "Bash(tail:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-bash.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-config.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "4",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1"
  }
}