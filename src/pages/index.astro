---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import ProblemSection from '../components/sections/ProblemSection.astro';
import PillarsSection from '../components/sections/PillarsSection.astro';
import HowItWorksSection from '../components/sections/HowItWorksSection.astro';
import VehiclesSection from '../components/sections/VehiclesSection.astro';
import SecuritySection from '../components/sections/SecuritySection.astro';
import ComparisonSection from '../components/sections/ComparisonSection.astro';
import HubShowcaseSection from '../components/sections/HubShowcaseSection.astro';
import ForWhomSection from '../components/sections/ForWhomSection.astro';
import ZonesSection from '../components/sections/ZonesSection.astro';
import FoundersSection from '../components/sections/FoundersSection.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import SurveyTeaserSection from '../components/sections/SurveyTeaserSection.astro';

const title = 'CLAVERA — Guarda segura de bicicletas en Buenos Aires';
const description =
	'Guardería segura de bicicletas y movilidad personal por membresía en Buenos Aires. Lugar asignado, acceso digital y vigilancia, a minutos de tu casa.';
---

<BaseLayout title={title} description={description}>
	<Hero />
	<ProblemSection />
	<PillarsSection />
	<HowItWorksSection />
	<VehiclesSection />
	<SecuritySection />
	<ComparisonSection />
	<HubShowcaseSection />
	<ForWhomSection />
	<ZonesSection />
	<FoundersSection />
	<FaqSection />
	<SurveyTeaserSection />
</BaseLayout>
