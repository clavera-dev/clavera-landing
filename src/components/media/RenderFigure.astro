---
/**
 * Renders one approved R1–R6 project render as a <figure>, with the
 * digitally-generated-render disclosure visible as real HTML text
 * (never baked into the bitmap or hidden from assistive tech).
 */
import { getRender, avifSrcset, webpSrcset, webpSrc, RENDER_DISCLOSURE, type RenderAsset } from '../../data/media';

interface Props {
	id: RenderAsset['id'];
	sizes?: string;
	loading?: 'lazy' | 'eager';
	fetchpriority?: 'high' | 'low' | 'auto';
	caption?: string;
}

const { id, sizes = '(min-width: 900px) 50vw, 100vw', loading = 'lazy', fetchpriority = 'auto', caption } = Astro.props;

const render = getRender(id);
const { width, height } = render.dimensions[1280];
---

<figure class="render-figure">
	<picture>
		<source type="image/avif" srcset={avifSrcset(render)} sizes={sizes} />
		<source type="image/webp" srcset={webpSrcset(render)} sizes={sizes} />
		<img
			src={webpSrc(render)}
			alt={render.alt}
			width={width}
			height={height}
			loading={loading}
			decoding="async"
			fetchpriority={fetchpriority}
		/>
	</picture>
	<figcaption>
		{caption && <span class="render-figure__caption">{caption}</span>}
		<span class="render-figure__disclosure">{RENDER_DISCLOSURE}</span>
	</figcaption>
</figure>

<style>
	.render-figure {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.render-figure picture,
	.render-figure img {
		width: 100%;
		height: auto;
		border-radius: var(--radius-lg);
		border: 1px solid var(--border-hairline);
	}

	.render-figure figcaption {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
	}

	.render-figure__caption {
		font-family: var(--font-sans);
		font-size: var(--text-label-sm-size);
		line-height: var(--text-label-sm-line);
		color: var(--text-secondary);
	}

	.render-figure__disclosure {
		font-family: var(--font-sans);
		font-size: var(--text-caption-size);
		line-height: var(--text-caption-line);
		color: var(--text-tertiary);
	}
</style>
