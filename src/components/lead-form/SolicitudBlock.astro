---
/**
 * Application block (CLAVERA_Dev_TZ_Bloque_Solicitud_v1_1, owner response
 * v1.4 §1.1). Rendered only while src/config/solicitud.ts is live — callers
 * check `isSolicitudLive()` and render nothing otherwise, so a switched-off
 * block is absent from the markup, not hidden.
 *
 * Order (TZ §3.1): eyebrow, heading, optional location hint, lead, three
 * steps, the one primary button, microcopy with the privacy link, the
 * mandatory disclaimer, the secondary survey link, the WhatsApp text link.
 * No image, counter, date, price or timer.
 *
 * The primary link opens the Spanish-only Typeform in a new tab. Its href is
 * complete in the markup (defaults for no JavaScript); the script below only
 * swaps in the four allowlisted, validated values from this page's own
 * address (TZ §3.4). Nothing is stored anywhere.
 */
import TypeformBoundary from './TypeformBoundary.astro';
import { getCopy, resolveLocale, localePath, LOCALE_DEFINITIONS } from '../../i18n';
import {
	SOLICITUD_DATA,
	solicitudLinkConfig,
	solicitudLocationHint,
	solicitudZoneLabel,
} from '../../config/solicitud';
import { buildSolicitudHref } from '../../config/solicitud-attribution';

const locale = resolveLocale(Astro.currentLocale);
const c = getCopy(Astro.currentLocale).solicitud;
const data = SOLICITUD_DATA.solicitud;
const linkConfig = solicitudLinkConfig(data);

const zone = solicitudZoneLabel(locale, data);
// The zone keeps its Spanish name wherever the label is the Spanish one.
const zoneLang = zone === data.zone_label.es && locale !== 'es' ? LOCALE_DEFINITIONS.es.lang : undefined;
const [headingBefore, headingAfter] = c.heading.split('{zone}');

const hint = solicitudLocationHint(locale, data);
const [hintBefore, hintAfter] = c.hint.split('{hint}');

const [microBefore, microAfter] = c.microcopy.split('{privacy}');

const href = buildSolicitudHref(linkConfig, locale);
---

<div class="solicitud" id="solicitud" data-solicitud>
	<div class="solicitud__head">
		<p class="eyebrow">{c.eyebrow}</p>
		<h2 id="solicitud-heading" class="solicitud__heading">
			{headingBefore}<span lang={zoneLang}>{zone}</span>{headingAfter}
		</h2>
		{hint !== null && <p class="body-md solicitud__hint" data-solicitud-hint>{hintBefore}{hint}{hintAfter}</p>}
		<p class="lede solicitud__lead">{c.lead}</p>
	</div>

	<ol class="solicitud__steps">
		{c.steps.map((step) => <li class="body-md">{step}</li>)}
	</ol>

	<div class="solicitud__action">
		<a
			class="button button--primary button--lg solicitud__cta"
			href={href}
			target="_blank"
			rel="noopener noreferrer"
			hreflang={LOCALE_DEFINITIONS.es.hreflang}
			aria-describedby="solicitud-microcopy solicitud-disclaimer"
			data-solicitud-link
			data-solicitud-language={locale}
			data-form-url={linkConfig.formUrl}
			data-consent-v={linkConfig.consentV}
			data-survey-version={linkConfig.surveyVersion}
			data-zone-slug={linkConfig.zoneSlug}
		>
			{c.cta}
			<span class="solicitud__arrow" aria-hidden="true">↗</span>
		</a>
		<p class="caption solicitud__microcopy" id="solicitud-microcopy">
			{microBefore}<a href={localePath(locale, 'privacidad')}>{c.privacyLink}</a>{microAfter}
		</p>
	</div>

	<p class="solicitud__disclaimer" id="solicitud-disclaimer" data-solicitud-disclaimer>{c.disclaimer}</p>

	<div class="solicitud__more">
		<TypeformBoundary flow="research" name="solicitud" variant="link" label={c.secondary} />
		<a
			class="solicitud__whatsapp body-md"
			href={data.whatsapp_url}
			target="_blank"
			rel="noopener noreferrer"
			data-solicitud-whatsapp
		>
			{c.whatsapp}
		</a>
	</div>
</div>

<script>
	import { buildSolicitudHref, type SolicitudLanguage } from '../../config/solicitud-attribution';

	// TZ §3.4: read this page's own address once, in memory only.
	for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-solicitud-link]')) {
		const { formUrl, consentV, surveyVersion, zoneSlug, solicitudLanguage } = link.dataset;
		if (!formUrl || !consentV || !surveyVersion || !zoneSlug || !solicitudLanguage) continue;
		link.href = buildSolicitudHref(
			{ formUrl, consentV, surveyVersion, zoneSlug },
			solicitudLanguage as SolicitudLanguage,
			window.location.search,
		);
	}
</script>

<style>
	.solicitud {
		display: flex;
		flex-direction: column;
		gap: var(--space-8);
		max-width: var(--measure);
	}

	.solicitud__head {
		display: flex;
		flex-direction: column;
		gap: var(--space-6);
	}

	.solicitud__heading {
		font-family: var(--font-display);
		font-size: var(--fluid-display);
		line-height: 1.04;
		letter-spacing: var(--text-display-2xl-tracking);
		font-weight: var(--text-display-2xl-weight);
		color: var(--text-primary);
		margin: 0;
		max-width: 18ch;
		text-wrap: balance;
	}

	.solicitud__hint {
		margin: 0;
		color: var(--text-secondary);
	}

	.solicitud__lead {
		margin: 0;
	}

	/* Numbered by the list itself, so no digit appears in the copy (TZ §6.5). */
	.solicitud__steps {
		margin: 0;
		padding-left: var(--space-6);
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		color: var(--text-secondary);
	}

	.solicitud__steps li::marker {
		font-family: var(--font-mono);
		color: var(--accent);
	}

	.solicitud__action {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-3);
	}

	.solicitud__arrow {
		transition: transform var(--duration-base) var(--ease-out);
	}

	.solicitud__cta:hover .solicitud__arrow {
		transform: translate(2px, -2px);
	}

	.solicitud__microcopy {
		margin: 0;
		color: var(--text-secondary);
	}

	.solicitud__microcopy a {
		color: inherit;
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	/*
	  Mandatory (TZ §3.1 item 8): at least 12px, at least 4.5:1, never
	  collapsed or moved to the footer. 14–16px secondary text on the base
	  surface measures well above 4.5:1.
	*/
	.solicitud__disclaimer {
		margin: 0;
		font-family: var(--font-sans);
		font-size: var(--text-label-md-size);
		line-height: var(--text-body-md-line);
		color: var(--text-secondary);
		padding-top: var(--space-6);
		border-top: 1px solid var(--border-hairline);
	}

	.solicitud__more {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-4);
	}

	.solicitud__whatsapp {
		color: var(--text-secondary);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.solicitud__whatsapp:hover {
		color: var(--text-primary);
	}

	/* One full-width primary on phones (TZ §3.6). */
	@media (max-width: 599px) {
		.solicitud__action {
			align-items: stretch;
		}

		.solicitud__cta {
			width: 100%;
		}
	}
</style>
