---
/**
 * Reserved boundary for the Typeform lead-capture embed.
 *
 * Lead capture is intentionally not implemented yet (PROJECT_DECISIONS.md:
 * "Do not implement Typeform yet"). This component is the one place the
 * rest of the page renders a lead-form CTA — nothing else should change
 * once src/config/typeform.ts is filled in.
 *
 * There are two independent Typeform targets (S11 Socios Fundadores and the
 * S13 research survey), each with its own URL. `target` selects which
 * config value this instance reads, so the survey CTA can never pick up
 * the founders URL (or vice versa) by accident.
 */
import { typeformConfig } from '../../config/typeform';

interface Props {
	target: 'founders' | 'survey';
	ctaLabel: string;
}

const { target, ctaLabel } = Astro.props;
const formUrl = target === 'founders' ? typeformConfig.foundersFormUrl : typeformConfig.surveyFormUrl;
const isConfigured = formUrl.length > 0;
---

<div class="typeform-boundary" data-typeform-boundary data-typeform-target={target}>
	{
		isConfigured ? (
			<a class="button button--primary" href={formUrl}>
				{ctaLabel}
			</a>
		) : (
			<button class="button button--primary" type="button" disabled>
				{ctaLabel}
			</button>
		)
	}
</div>

<style>
	.typeform-boundary {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-2);
	}

	.button:disabled {
		opacity: 0.6;
		cursor: not-allowed;
	}
</style>
