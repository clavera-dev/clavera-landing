---
/**
 * Reserved boundary for the Typeform lead-capture embed.
 *
 * Lead capture is intentionally not implemented yet. This component is the one
 * place the rest of the page renders a lead-form CTA — nothing else should
 * change once src/config/typeform.ts is filled in.
 *
 * There are two independent Typeform targets (S11 Socios Fundadores and the
 * S13 research survey), each with its own URL. `target` selects which config
 * value this instance reads, so the survey CTA can never pick up the founders
 * URL (or vice versa) by accident.
 *
 * While a URL is empty the control stays inert: it renders as a disabled
 * button, never as a link to nowhere.
 */
import { typeformConfig } from '../../config/typeform';

interface Props {
	target: 'founders' | 'survey';
	ctaLabel: string;
	size?: 'md' | 'lg';
	variant?: 'primary' | 'ghost';
}

const { target, ctaLabel, size = 'md', variant = 'primary' } = Astro.props;
const formUrl = target === 'founders' ? typeformConfig.foundersFormUrl : typeformConfig.surveyFormUrl;
const isConfigured = formUrl.length > 0;

const buttonClass = ['button', `button--${variant}`, size === 'lg' && 'button--lg']
	.filter(Boolean)
	.join(' ');
---

<div class="typeform-boundary" data-typeform-boundary data-typeform-target={target}>
	{
		isConfigured ? (
			<a class={buttonClass} href={formUrl}>
				{ctaLabel}
				<span class="typeform-boundary__arrow" aria-hidden="true">
					→
				</span>
			</a>
		) : (
			<button class={buttonClass} type="button" disabled>
				{ctaLabel}
				<span class="typeform-boundary__arrow" aria-hidden="true">
					→
				</span>
			</button>
		)
	}
</div>

<style>
	.typeform-boundary {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-2);
	}

	.typeform-boundary__arrow {
		transition: transform var(--duration-base) var(--ease-out);
	}

	.button:hover:not(:disabled) .typeform-boundary__arrow {
		transform: translateX(3px);
	}
</style>
