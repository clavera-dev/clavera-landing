---
/**
 * The one place the page links out to Typeform.
 *
 * Two flows, both locale-routed from src/config/typeform.ts:
 *
 *   flow="pilot"    — the short "Avisame" form. Its URLs are still being
 *                     created, so its destination may be `null`.
 *   flow="research" — the research survey. Primary in "Sumate al piloto"
 *                     while the Avisame form is absent; secondary otherwise.
 *
 * Nothing else on the page may build a Typeform URL, so a locale can never be
 * pointed at the wrong destination by a component that hard-codes one. (The
 * zone selector asks src/config/typeform.ts for its per-zone hrefs through the
 * same `buildResearchHref`.)
 *
 * PENDING DESTINATIONS. When the pilot flow has no URL for this locale the
 * component renders NOTHING (owner handoff v1.1 B4: "do not show the button
 * until the URL is delivered", and the "en preparación" line is removed). It
 * never renders an anchor with `href="#"`, an empty href, a placeholder
 * domain, a disabled button, or any other control that looks actionable and
 * is not. Supplying the URL in the central config is the only change needed.
 *
 * Configured destinations are ordinary same-tab links: they work with
 * JavaScript disabled, need no Typeform SDK, and this component ships no
 * client-side script.
 *
 * When the destination is not written in the page's language — English, whose
 * research survey is Spanish as an approved beta compromise — the notice next
 * to the link says so, wired through `aria-describedby` so a screen-reader
 * user is told before following it, not after.
 *
 * Only allowlisted, non-personal attribution is ever appended
 * (src/config/typeform.ts). No personal data is put in a URL.
 */
import {
	getPilotDestination,
	getResearchDestination,
	destinationLanguageDiffers,
	buildDestinationHref,
	buildResearchHref,
	type PendingDestination,
} from '../../config/typeform';
import { getCopy, resolveLocale, LOCALE_DEFINITIONS } from '../../i18n';

interface Props {
	flow: 'pilot' | 'research';
	/** Distinguishes the instances so their notice ids stay unique and stable. */
	name: string;
	size?: 'md' | 'lg';
	variant?: 'primary' | 'ghost';
	/** Overrides the flow's default label, e.g. "Respondé la encuesta". */
	label?: string;
}

const { flow, name, size = 'md', variant = 'primary', label: labelOverride } = Astro.props;

const locale = resolveLocale(Astro.currentLocale);
const copy = getCopy(Astro.currentLocale);

const destination: PendingDestination =
	flow === 'pilot' ? getPilotDestination(locale) : getResearchDestination(locale);

const label = labelOverride ?? (flow === 'pilot' ? copy.pilot.cta : copy.survey.cta);

/*
  The notice is shown when — and only when — the destination's language differs
  from the page's. Both halves are required: the copy string is empty on the
  locales whose destination matches, and the config is the authority on which
  those are.
*/
const languageNotice = flow === 'research' ? copy.survey.languageNotice : '';
const showLanguageNotice =
	destinationLanguageDiffers(locale, destination) && languageNotice.length > 0;
const noticeId = `destination-language-${name}`;

/*
  Attribution differs per flow.

  Research: the handoff v1.1 §4.1 fragment (`#recruitment_source=…`), fixed per
  locale, with no `candidate_zone` because no zone is chosen here — the zone
  selector builds its own per-zone hrefs through the same function.

  Pilot: allowlisted, non-personal build-time query attribution (`lang`,
  `source`). The visitor's own incoming `utm_*` values are NOT forwarded.
*/
const href =
	destination === null
		? null
		: flow === 'pilot'
			? buildDestinationHref(destination.url, { lang: locale, source: 'landing' })
			: buildResearchHref(locale);

const buttonClass = ['button', `button--${variant}`, size === 'lg' && 'button--lg']
	.filter(Boolean)
	.join(' ');
---

{/* A pending destination renders nothing at all — see the header comment. */}
{
	href !== null && (
		<div
			class="typeform-boundary"
			data-typeform-boundary
			data-typeform-flow={flow}
			data-typeform-state="live"
		>
			<a
				class={buttonClass}
				href={href}
				hreflang={LOCALE_DEFINITIONS[destination!.language].hreflang}
				aria-describedby={showLanguageNotice ? noticeId : undefined}
			>
				{label}
				<span class="typeform-boundary__arrow" aria-hidden="true">
					↗
				</span>
			</a>

			{showLanguageNotice && (
				<p class="caption typeform-boundary__notice" id={noticeId} data-destination-language-notice>
					{languageNotice}
				</p>
			)}
		</div>
	)
}

<style>
	.typeform-boundary {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-2);
	}

	.typeform-boundary__arrow {
		transition: transform var(--duration-base) var(--ease-out);
	}

	.button:hover .typeform-boundary__arrow {
		transform: translate(2px, -2px);
	}

	.typeform-boundary__notice {
		max-width: 40ch;
	}
</style>
