---
/**
 * The one place the page links out to Typeform.
 *
 * The expedited public beta (M3.5) exposes a single Typeform destination — the
 * long research survey — and it is locale-routed: every locale has its own
 * entry in src/config/typeform.ts. Nothing else on the page may build a
 * Typeform URL, so a locale can never be pointed at the wrong survey by a
 * component that happens to hard-code one.
 *
 * The control is an ordinary link, not an embed and not a script: it works
 * with JavaScript disabled and needs no Typeform SDK. It navigates in the same
 * tab, so there is no undisclosed new window to announce.
 *
 * When the survey is not written in the language of the page — English, which
 * uses the Spanish survey as an approved beta compromise — the notice next to
 * the link says so, and is wired to the link through `aria-describedby` so a
 * screen-reader user is told before following it, not after.
 *
 * No personal data is put in the URL (PROJECT_DECISIONS.md).
 */
import { getSurveyDestination, surveyLanguageDiffers } from '../../config/typeform';
import { getCopy, resolveLocale, LOCALE_DEFINITIONS } from '../../i18n';

interface Props {
	/** Distinguishes the instances so their notice ids stay unique and stable. */
	name: string;
	size?: 'md' | 'lg';
	variant?: 'primary' | 'ghost';
}

const { name, size = 'md', variant = 'primary' } = Astro.props;

const locale = resolveLocale(Astro.currentLocale);
const copy = getCopy(Astro.currentLocale);
const destination = getSurveyDestination(locale);

/*
  The notice is shown when — and only when — the survey's language differs from
  the page's. Both halves are required: the copy string is empty on the locales
  whose survey matches, and the config is the authority on which those are.
*/
const showLanguageNotice = surveyLanguageDiffers(locale) && copy.survey.languageNotice.length > 0;
const noticeId = `survey-language-${name}`;

const buttonClass = ['button', `button--${variant}`, size === 'lg' && 'button--lg']
	.filter(Boolean)
	.join(' ');
---

<div class="typeform-boundary" data-typeform-boundary data-typeform-target="survey">
	<a
		class={buttonClass}
		href={destination.url}
		hreflang={LOCALE_DEFINITIONS[destination.language].hreflang}
		aria-describedby={showLanguageNotice ? noticeId : undefined}
	>
		{copy.survey.cta}
		<span class="typeform-boundary__arrow" aria-hidden="true">↗</span>
	</a>

	{
		showLanguageNotice && (
			<p class="caption typeform-boundary__notice" id={noticeId} data-survey-language-notice>
				{copy.survey.languageNotice}
			</p>
		)
	}
</div>

<style>
	.typeform-boundary {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-2);
	}

	.typeform-boundary__arrow {
		transition: transform var(--duration-base) var(--ease-out);
	}

	.button:hover .typeform-boundary__arrow {
		transform: translate(2px, -2px);
	}

	.typeform-boundary__notice {
		max-width: 40ch;
	}
</style>
