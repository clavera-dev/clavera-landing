---
/**
 * The one place the page links out to Typeform.
 *
 * Two flows, both locale-routed from src/config/typeform.ts:
 *
 *   flow="pilot"    — the short pilot-interest form, the primary beta
 *                     conversion. Its URLs are still being created, so its
 *                     destination may be `null`.
 *   flow="research" — the long research survey, a secondary action.
 *
 * Nothing else on the page may build a Typeform URL, so a locale can never be
 * pointed at the wrong destination by a component that hard-codes one.
 *
 * PENDING DESTINATIONS. When a flow has no URL for this locale the component
 * renders localized plain, non-interactive text. It never renders an anchor
 * with `href="#"`, an empty href, a placeholder domain, a disabled button, or
 * any other control that looks actionable and is not. Supplying the URL in the
 * central config is the only change needed to turn the text into a real link.
 *
 * Configured destinations are ordinary same-tab links: they work with
 * JavaScript disabled, need no Typeform SDK, and this component ships no
 * client-side script.
 *
 * When the destination is not written in the page's language — English, whose
 * research survey is Spanish as an approved beta compromise — the notice next
 * to the link says so, wired through `aria-describedby` so a screen-reader
 * user is told before following it, not after.
 *
 * Only allowlisted, non-personal attribution parameters are ever appended
 * (src/config/typeform.ts). No personal data is put in a URL.
 */
import {
	getPilotDestination,
	getResearchDestination,
	destinationLanguageDiffers,
	buildDestinationHref,
	type PendingDestination,
} from '../../config/typeform';
import { getCopy, resolveLocale, LOCALE_DEFINITIONS } from '../../i18n';

interface Props {
	flow: 'pilot' | 'research';
	/** Distinguishes the instances so their notice ids stay unique and stable. */
	name: string;
	size?: 'md' | 'lg';
	variant?: 'primary' | 'ghost';
}

const { flow, name, size = 'md', variant = 'primary' } = Astro.props;

const locale = resolveLocale(Astro.currentLocale);
const copy = getCopy(Astro.currentLocale);

const destination: PendingDestination =
	flow === 'pilot' ? getPilotDestination(locale) : getResearchDestination(locale);

const label = flow === 'pilot' ? copy.pilot.cta : copy.survey.cta;
const pendingText = flow === 'pilot' ? copy.pilot.pendingNote : '';

/*
  The notice is shown when — and only when — the destination's language differs
  from the page's. Both halves are required: the copy string is empty on the
  locales whose destination matches, and the config is the authority on which
  those are.
*/
const languageNotice = flow === 'research' ? copy.survey.languageNotice : '';
const showLanguageNotice =
	destinationLanguageDiffers(locale, destination) && languageNotice.length > 0;
const noticeId = `destination-language-${name}`;

/*
  Attribution applies to the PILOT flow only.

  The research-survey mapping is accepted and must render exactly the approved
  bare URLs, so nothing is appended to it. The pilot destinations are new, so
  they carry allowlisted, non-personal build-time attribution: `lang` and
  `source` are known when the page is generated. The visitor's own incoming
  `utm_*` values are deliberately NOT forwarded — reading them would mean
  shipping client-side JavaScript to a page that ships none.
*/
const href =
	destination === null
		? null
		: flow === 'pilot'
			? buildDestinationHref(destination.url, { lang: locale, source: 'landing' })
			: destination.url;

const buttonClass = ['button', `button--${variant}`, size === 'lg' && 'button--lg']
	.filter(Boolean)
	.join(' ');
---

<div
	class="typeform-boundary"
	data-typeform-boundary
	data-typeform-flow={flow}
	data-typeform-state={href === null ? 'pending' : 'live'}
>
	{
		href === null ? (
			/* Plain text, not a control: nothing here is focusable or clickable. */
			<p class="body-md typeform-boundary__pending" data-typeform-pending>
				{pendingText}
			</p>
		) : (
			<a
				class={buttonClass}
				href={href}
				hreflang={LOCALE_DEFINITIONS[destination!.language].hreflang}
				aria-describedby={showLanguageNotice ? noticeId : undefined}
			>
				{label}
				<span class="typeform-boundary__arrow" aria-hidden="true">
					↗
				</span>
			</a>
		)
	}

	{
		showLanguageNotice && (
			<p class="caption typeform-boundary__notice" id={noticeId} data-destination-language-notice>
				{languageNotice}
			</p>
		)
	}
</div>

<style>
	.typeform-boundary {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-2);
	}

	.typeform-boundary__arrow {
		transition: transform var(--duration-base) var(--ease-out);
	}

	.button:hover .typeform-boundary__arrow {
		transform: translate(2px, -2px);
	}

	.typeform-boundary__notice {
		max-width: 40ch;
	}

	/* Reads as a status line, not as a control that failed to render. */
	.typeform-boundary__pending {
		color: var(--text-tertiary);
		max-width: var(--measure);
	}
</style>
