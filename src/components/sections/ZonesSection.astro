---
import Section from '../layout/Section.astro';
import { getCopy } from '../../i18n';

const c = getCopy(Astro.currentLocale).zones;

/**
 * Zone list per PROJECT_DECISIONS.md "Initial areas" — this overrides the
 * larger nine-barrio list in the brief (§S10), which is superseded for
 * phase one.
 *
 * Set at display scale rather than as accent pills: these four names are the
 * section's entire content, and the brand system reserves pill radius for
 * status badges.
 */
---

<Section
	id="zonas"
	index={c.index}
	railLabel={c.rail}
	surface="raised"
	divider
	eyebrow={c.eyebrow}
	heading={c.heading}
>
	<p slot="lede" class="lede">{c.lede}</p>

	<ol class="zones">
		{
			c.items.map((zone, i) => (
				<li class="zones__item">
					<span class="mono zones__n">{String(i + 1).padStart(2, '0')}</span>
					<span class="zones__name">{zone}</span>
				</li>
			))
		}
	</ol>

	<p class="body-md zones__note">{c.note}</p>
</Section>

<style>
	.zones {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: 1fr;
	}

	.zones__item {
		display: flex;
		align-items: baseline;
		gap: var(--space-4);
		padding-block: var(--space-5);
		border-top: 1px solid var(--border-hairline);
	}

	.zones__item:last-child {
		border-bottom: 1px solid var(--border-hairline);
	}

	.zones__n {
		color: var(--accent);
	}

	.zones__name {
		font-family: var(--font-display);
		font-size: var(--fluid-display-sm);
		line-height: 1.1;
		letter-spacing: var(--text-display-lg-tracking);
		font-weight: 700;
		color: var(--text-primary);
	}

	.zones__note {
		margin-top: var(--space-10);
		max-width: var(--measure);
	}

	@media (min-width: 800px) {
		.zones {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			column-gap: var(--space-16);
		}

		.zones__item {
			padding-block: var(--space-6);
		}

		.zones__item:nth-last-child(-n + 2) {
			border-bottom: 1px solid var(--border-hairline);
		}
	}
</style>
