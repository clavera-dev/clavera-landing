---
import Section from '../layout/Section.astro';
import { getCopy } from '../../i18n';

const c = getCopy(Astro.currentLocale).zones;

/**
 * The owner-approved nine-area beta set (PROJECT_DECISIONS.md, "Beta areas
 * (2026-08-23)"), which supersedes the earlier four-area list and matches the
 * nine names in brief §S10 / §10.1.
 *
 * UNORDERED AND UNNUMBERED ON PURPOSE. The previous version was an `<ol>` with
 * `01`–`04` markers, which reads as an opening order or a priority ranking.
 * None exists: these are areas under evaluation, listed alphabetically, and
 * the list carries a disclaimer saying so. Do not reintroduce numbering,
 * ranking, a "first district", addresses, pins, dates or counters.
 *
 * Set at display scale rather than as accent pills: the names are the
 * section's entire content, and the brand system reserves pill radius for
 * status badges.
 */
---

<Section
	id="zonas"
	index={c.index}
	railLabel={c.rail}
	surface="raised"
	divider
	eyebrow={c.eyebrow}
	heading={c.heading}
>
	<p slot="lede" class="lede">{c.lede}</p>

	<ul class="zones">
		{
			c.items.map((zone) => (
				<li class="zones__item">
					<span class="zones__name">{zone}</span>
				</li>
			))
		}
	</ul>

	<p class="body-md zones__note">{c.note}</p>
	<p class="caption zones__disclaimer" data-zones-disclaimer>{c.disclaimer}</p>
</Section>

<style>
	.zones {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: 1fr;
	}

	.zones__item {
		display: flex;
		align-items: baseline;
		gap: var(--space-4);
		padding-block: var(--space-5);
		border-top: 1px solid var(--border-hairline);
	}

	.zones__item:last-child {
		border-bottom: 1px solid var(--border-hairline);
	}

	.zones__name {
		font-family: var(--font-display);
		font-size: var(--fluid-display-sm);
		line-height: 1.1;
		letter-spacing: var(--text-display-lg-tracking);
		font-weight: 700;
		color: var(--text-primary);
	}

	.zones__note {
		margin-top: var(--space-10);
		max-width: var(--measure);
	}

	.zones__disclaimer {
		margin-top: var(--space-4);
		max-width: var(--measure);
	}

	@media (min-width: 800px) {
		.zones {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			column-gap: var(--space-16);
		}

		.zones__item {
			padding-block: var(--space-6);
		}

		.zones__item:nth-last-child(-n + 2) {
			border-bottom: 1px solid var(--border-hairline);
		}
	}
</style>
