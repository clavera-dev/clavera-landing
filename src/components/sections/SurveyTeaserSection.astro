---
import Section from '../layout/Section.astro';
import TypeformBoundary from '../lead-form/TypeformBoundary.astro';
import { getCopy } from '../../i18n';

const c = getCopy(Astro.currentLocale).survey;

/**
 * The research survey — the only Typeform destination the public beta exposes.
 * Its URL is locale-routed inside TypeformBoundary; nothing here knows it.
 *
 * Set deliberately quiet and low-contrast, per brief S13, which puts this
 * section below the FAQ at a reduced visual weight.
 */
---

<Section id="encuesta" labelledby="encuesta-heading" rhythm="coda">
	<div class="survey">
		<div class="survey__text">
			<p class="eyebrow">{c.eyebrow}</p>
			{/* A top-level page section, so h2 — it keeps the h3 type scale
			    because it is deliberately the quietest block on the page. */}
			<h2 id="encuesta-heading" class="heading-h3 survey__heading">{c.heading}</h2>
			<p class="body-md">{c.note}</p>
		</div>

		<TypeformBoundary name="encuesta" variant="ghost" />
	</div>
</Section>

<style>
	.survey {
		display: flex;
		flex-direction: column;
		gap: var(--space-8);
		padding-block: var(--space-10);
		border-top: 1px solid var(--border-hairline);
		border-bottom: 1px solid var(--border-hairline);
	}

	.survey__text {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		max-width: var(--measure);
	}

	.survey__heading {
		color: var(--text-primary);
	}

	@media (min-width: 800px) {
		.survey {
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
			gap: var(--space-12);
		}
	}
</style>
