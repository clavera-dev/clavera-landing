---
import Section from '../layout/Section.astro';
import { getCopy } from '../../i18n';

const c = getCopy(Astro.currentLocale).faq;

/**
 * FAQ-09's zone clause is adjusted from the brief's zone-A list to the areas
 * approved in PROJECT_DECISIONS.md ("Initial areas"), which overrides the
 * brief where they conflict — same as src/components/sections/ZonesSection.astro.
 *
 * FAQ-02 ("¿Puedo entrar cuando quiera?") is removed: its answer depended on
 * "horario amplio", an operating-hours claim PROJECT_DECISIONS.md says is
 * unconfirmed. FAQ-05's insurance wording is untouched — it is the brief's
 * specifically permitted formulation and is not part of this correction.
 */
---

<Section
	id="faq"
	index={c.index}
	railLabel={c.rail}
	divider
	eyebrow={c.eyebrow}
	heading={c.heading}
>
	<div class="faq">
		{
			c.items.map((faq) => (
				<details class="faq__item">
					<summary class="faq__q">
						<span class="faq__q-text">{faq.q}</span>
						<span class="faq__mark" aria-hidden="true" />
					</summary>
					<div class="faq__a">
						<p class="body-md">{faq.a}</p>
					</div>
				</details>
			))
		}
	</div>
</Section>

<style>
	/*
	  Hairline rows rather than nine bordered boxes. On desktop the question
	  holds the left column and its answer opens in the right one, so an open
	  item reads as an annotated line instead of an expanding card.
	*/
	.faq {
		border-top: 1px solid var(--border-hairline);
	}

	.faq__item {
		border-bottom: 1px solid var(--border-hairline);
	}

	.faq__q {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: var(--space-6);
		padding-block: var(--space-6);
		cursor: pointer;
		list-style: none;
		font-family: var(--font-display);
		font-size: var(--text-h4-size);
		line-height: var(--text-h4-line);
		font-weight: var(--text-h4-weight);
		color: var(--text-primary);
		transition: color var(--duration-fast) var(--ease-standard);
	}

	.faq__q::-webkit-details-marker {
		display: none;
	}

	.faq__q:hover {
		color: var(--accent);
	}

	.faq__q:focus-visible {
		outline: 2px solid var(--focus-ring);
		outline-offset: -2px;
	}

	/* A drawn plus/minus rather than a text glyph, so it stays optically
	   centred at every size. */
	.faq__mark {
		position: relative;
		flex: none;
		width: 14px;
		height: 14px;
		margin-top: 0.4em;
	}

	.faq__mark::before,
	.faq__mark::after {
		content: '';
		position: absolute;
		inset: 50% 0 auto 0;
		height: 2px;
		background: var(--accent);
		transform: translateY(-50%);
		transition: opacity var(--duration-fast) var(--ease-standard);
	}

	.faq__mark::after {
		inset: 0 50% auto auto;
		width: 2px;
		height: 100%;
		transform: translateX(50%);
	}

	.faq__item[open] .faq__mark::after {
		opacity: 0;
	}

	.faq__a {
		padding-bottom: var(--space-6);
		max-width: var(--measure);
	}

	@media (min-width: 900px) {
		.faq__item {
			display: grid;
			grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr);
			column-gap: var(--space-12);
			align-items: start;
		}

		.faq__q {
			grid-column: 1;
			padding-block: var(--space-8);
		}

		.faq__q-text {
			/* Preferred measure; a longer translated question wraps to more
			   lines rather than colliding with the +/- marker. */
			max-width: 28ch;
		}

		.faq__a {
			grid-column: 2;
			padding-block: var(--space-8);
		}
	}
</style>
