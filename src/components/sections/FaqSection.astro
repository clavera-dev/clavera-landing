---
import Typeset from '../typography/Typeset.astro';
import Section from '../layout/Section.astro';
import { getCopy } from '../../i18n';

const c = getCopy(Astro.currentLocale).faq;

/**
 * FAQ-09's zone clause is adjusted from the brief's zone-A list to the areas
 * approved in PROJECT_DECISIONS.md ("Initial areas"), which overrides the
 * brief where they conflict — same as src/components/sections/ZonesSection.astro.
 *
 * FAQ-02 ("¿Puedo entrar cuando quiera?") is removed: its answer depended on
 * "horario amplio", an operating-hours claim PROJECT_DECISIONS.md says is
 * unconfirmed. FAQ-05's insurance wording is untouched — it is the brief's
 * specifically permitted formulation and is not part of this correction.
 *
 * Raised, so the tail alternates surfaces around the base "Sumate al piloto"
 * block (composition spec R-6 (a)).
 *
 * Redesign H (spec §3.10): one column of questions, each answer opening
 * under its own question. On wide screens the heading holds the left column
 * and the list the right one, so the list reads at a comfortable measure
 * instead of running the full page width.
 */
---

<Section
	id="faq"
	index={c.index}
	railLabel={c.rail}
	surface="raised"
	divider
	labelledby="faq-heading"
>
	<div class="faq-layout">
		<header class="faq__head">
			<p class="eyebrow">{c.eyebrow}</p>
			<h2 id="faq-heading" class="heading-h2"><Typeset text={c.heading} /></h2>
		</header>

		<div class="faq">
			{
				c.items.map((faq) => (
					<details class="faq__item">
						<summary class="faq__q">
							<span class="faq__q-text">{faq.q}</span>
							<span class="faq__mark" aria-hidden="true" />
						</summary>
						<div class="faq__a">
							<p class="body-md">{faq.a}</p>
						</div>
					</details>
				))
			}
		</div>
	</div>
</Section>

<style>
	/* One column at every width: heading above, questions below, like every
	   other section. A heading-beside-list split left a tall empty column
	   and repeated the "Para quién" composition two sections earlier. */
	.faq-layout {
		display: flex;
		flex-direction: column;
		gap: var(--space-12);
	}

	.faq__head {
		display: flex;
		flex-direction: column;
		gap: var(--space-5);
	}

	/* The same measure as the shared section headings (Section.astro). */
	.faq__head .heading-h2 {
		max-width: 20ch;
	}

	/* Hairline rows rather than bordered boxes, at a reading width: the
	   marker stays near the question it belongs to. */
	.faq {
		max-width: 52rem;
		border-top: 1px solid var(--border-hairline);
	}

	.faq__item {
		border-bottom: 1px solid var(--border-hairline);
	}

	.faq__q {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: var(--space-6);
		padding-block: var(--space-6);
		cursor: pointer;
		list-style: none;
		font-family: var(--font-display);
		font-size: var(--text-h4-size);
		line-height: var(--text-h4-line);
		font-weight: var(--text-h4-weight);
		color: var(--text-primary);
		transition: color var(--duration-fast) var(--ease-standard);
	}

	.faq__q::-webkit-details-marker {
		display: none;
	}

	.faq__q:hover {
		color: var(--accent);
	}

	.faq__q:focus-visible {
		outline: 2px solid var(--focus-ring);
		outline-offset: -2px;
	}

	/* The question text moves, not the row: the +/- marker and the hairline
	   stay put while the words step in on hover (pointer devices, motion
	   allowed — see src/styles/motion.css). */
	.faq__q-text {
		display: block;
		text-wrap: pretty;
	}

	/* A drawn plus/minus rather than a text glyph, so it stays optically
	   centred at every size. */
	.faq__mark {
		position: relative;
		flex: none;
		width: 14px;
		height: 14px;
		margin-top: 0.4em;
	}

	.faq__mark::before,
	.faq__mark::after {
		content: '';
		position: absolute;
		inset: 50% 0 auto 0;
		height: 2px;
		background: var(--text-secondary);
		transform: translateY(-50%);
		transition: opacity var(--duration-fast) var(--ease-standard);
	}

	.faq__mark::after {
		inset: 0 50% auto auto;
		width: 2px;
		height: 100%;
		transform: translateX(50%);
	}

	.faq__item[open] .faq__mark::after {
		opacity: 0;
	}

	/* Neutral at rest; amber only when the row is pointed at or open. */
	.faq__q:hover .faq__mark::before,
	.faq__q:hover .faq__mark::after,
	.faq__item[open] .faq__mark::before {
		background: var(--accent);
	}

	.faq__a {
		padding-bottom: var(--space-8);
		max-width: var(--measure);
	}

	@media (min-width: 900px) {
		.faq-layout {
			gap: var(--space-16);
		}

		.faq__head {
			gap: var(--space-6);
		}

		.faq__q {
			padding-block: var(--space-8);
		}
	}
</style>
