---
import Section from '../layout/Section.astro';
import RenderFigure from '../media/RenderFigure.astro';
import { getRender, type RenderAsset } from '../../data/media';

/**
 * The full approved R1–R6 set (PROJECT_DECISIONS.md), in order. R3 is the
 * self-service bicycle-cleaning render — a real approved asset, not the
 * older "entrance" file (see src/data/media.ts for why those are distinct
 * and why the entrance shot lives only in the Security section).
 */
const galleryIds: RenderAsset['id'][] = ['r1', 'r2', 'r3', 'r4', 'r5', 'r6'];
---

<Section id="hub" eyebrow="El espacio" heading="Así está diseñado un hub CLAVERA.">
	<p slot="lede" class="body-lg">
		Cada hub se proyecta con el mismo estándar: lugares independientes, circulación libre, materiales que resisten
		uso diario.
	</p>
	<div class="hub-gallery">
		{galleryIds.map((id) => <RenderFigure id={id} caption={getRender(id).caption} />)}
	</div>
</Section>

<style>
	.hub-gallery {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-6);
	}

	@media (min-width: 640px) {
		.hub-gallery {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 1100px) {
		.hub-gallery {
			grid-template-columns: repeat(3, 1fr);
		}
	}
</style>
