---
import Section from '../layout/Section.astro';
import RenderFigure from '../media/RenderFigure.astro';
import { getCopy } from '../../i18n';

const c = getCopy(Astro.currentLocale).hub;

/**
 * The approved R1–R6 set is deliberately NOT shown here as a six-up gallery.
 * Each render carries a different argument and is placed where that argument
 * is being made: R1 is the hero, R2 opens the solution, R5 is the full-width
 * band in "qué podés guardar". This section holds the three that belong
 * together as "how a hub is designed":
 *
 *   R6 — the zoning drawing. It is an axonometric on a cream ground, so it is
 *        mounted on a paper sheet inset into the dark surface; the drawing
 *        meets its mount instead of floating on a graphite box.
 *   R4 — lockers and family storage, kept with its caption (owner handoff
 *        v1.1 §3.5).
 *
 * R3, the self-service cleaning bay, is removed (handoff §3.5: the cleaning
 * zone is no longer a planned feature). Its derivatives stay in the repository
 * so reinstating it is one line; the spread it formed with R4 is now a single
 * landscape figure.
 *
 * The legend under the drawing names only what is literally visible in the
 * approved render, matching its alt text.
 *
 * Redesign H (spec §3.9): R4 used to sit in a 64 % column on the right with
 * an empty left half and dead space under it — the composition hole of the
 * old page. It now runs the full content width under the plan, cropped to a
 * wide frame that keeps the lit sign, the lockers and the open baby-seat
 * bay, with its caption beneath. The plan sheet is the page's third loud
 * moment after the hero and the vehicles band.
 */
---

<Section
	id="hub"
	index={c.index}
	railLabel={c.rail}
	eyebrow={c.eyebrow}
	heading={c.heading}
	rhythm="default"
>
	<p slot="lede" class="lede">{c.lede}</p>

	<div class="hub">
		<div class="hub__plan surface-paper">
			<div class="hub__drawing">
				<RenderFigure id="r6" variant="plain" sizes="(min-width: 900px) 52vw, 88vw" />
			</div>

			<div class="hub__legend">
				<p class="mono mono--accent">{c.legendTitle}</p>
				<ol class="hub__legend-list">
					{
						c.legend.map((zone, i) => (
							<li>
								<span class="numeral hub__legend-n">{String(i + 1).padStart(2, '0')}</span>
								<span class="hub__legend-label">{zone}</span>
							</li>
						))
					}
				</ol>
			</div>
		</div>

		<div class="hub__wide">
			<RenderFigure
				id="r4"
				variant="cover"
				sizes="(min-width: 1320px) 1100px, 92vw"
				position="50% 38%"
				caption
			/>
		</div>
	</div>
</Section>

<style>
	.hub {
		display: flex;
		flex-direction: column;
		gap: var(--space-16);
	}

	/* A framed photograph at the content width: the natural 3:2 on a phone,
	   a wide 2:1 crop from 900px. */
	.hub__wide {
		--figure-ratio: 3 / 2;
	}

	.hub__wide :global(picture) {
		border-radius: var(--radius-xl);
		box-shadow: 0 0 0 1px var(--border-hairline);
	}

	/* Plan sheet ---------------------------------------------------------- */

	.hub__plan {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-8);
		padding: var(--space-6);
		border-radius: var(--radius-xl);
	}

	.hub__drawing :global(picture) {
		border-radius: var(--radius-md);
	}

	.hub__legend {
		display: flex;
		flex-direction: column;
		gap: var(--space-5);
	}

	.hub__legend-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
	}

	.hub__legend-list li {
		display: flex;
		align-items: baseline;
		gap: var(--space-4);
		padding-block: var(--space-3);
		border-top: 1px solid var(--border-hairline);
	}

	.hub__legend-list li:last-child {
		border-bottom: 1px solid var(--border-hairline);
	}

	.hub__legend-n {
		font-size: var(--text-mono-sm-size);
		letter-spacing: var(--text-mono-sm-tracking);
	}

	.hub__legend-label {
		font-family: var(--font-sans);
		font-size: var(--text-body-md-size);
		line-height: var(--text-body-md-line);
		color: var(--text-primary);
	}

	@media (min-width: 900px) {
		.hub__plan {
			grid-template-columns: minmax(0, 1fr) minmax(0, 0.42fr);
			gap: var(--space-12);
			align-items: center;
			padding: var(--space-10);
		}

		.hub__wide {
			--figure-ratio: 2 / 1;
		}
	}

	@media (min-width: 1100px) {
		.hub__plan {
			padding: var(--space-12);
		}
	}
</style>
