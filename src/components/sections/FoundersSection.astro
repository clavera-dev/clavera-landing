---
import Section from '../layout/Section.astro';
import TypeformBoundary from '../lead-form/TypeformBoundary.astro';
import { getPilotDestination } from '../../config/typeform';
import { getCopy, resolveLocale } from '../../i18n';

const c = getCopy(Astro.currentLocale).founders;
const pilotLive = getPilotDestination(resolveLocale(Astro.currentLocale)) !== null;

/**
 * "Sumate al piloto" (owner handoff v1.1 B4), which replaces the Socios
 * Fundadores block. The anchor stays `#fundadores` because the header CTA
 * points at it.
 *
 * Every founding-offer number is gone — the 40 / −20 % / 24 figures, the
 * discount sentence and the price-calculation line — and so is the
 * "Formulario de interés en preparación" line.
 *
 * Buttons. The primary action is "Avisame", the short pilot form, but its URL
 * has not been delivered, and until it is the button is not shown at all.
 * Meanwhile the research survey is the primary action. Once the Avisame URL
 * is configured in src/config/typeform.ts, this renders "Avisame" as primary,
 * then "¿Tenés 3 minutos más?" with the survey as the secondary link — with
 * no other change.
 *
 * Still the page's one full-weight amber moment: the amber rule along the top
 * edge and its largest call to action.
 */
---

<Section
	id="fundadores"
	index={c.index}
	railLabel={c.rail}
	surface="raised"
	labelledby="fundadores-heading"
	rhythm="loose"
	accent
>
	<div class="founders__inner">
		<div class="founders__head">
			<p class="eyebrow">{c.eyebrow}</p>
			<h2 id="fundadores-heading" class="founders__heading">{c.heading}</h2>
			<p class="lede founders__lede">{c.lede}</p>
		</div>

		<div class="founders__action">
			{
				pilotLive ? (
					<div class="founders__buttons">
						<TypeformBoundary flow="pilot" name="fundadores" size="lg" />
						<div class="founders__secondary">
							<p class="body-md">{c.surveyPrompt}</p>
							<TypeformBoundary
								flow="research"
								name="fundadores"
								variant="ghost"
								label={c.surveyCta}
							/>
						</div>
					</div>
				) : (
					<>
						<TypeformBoundary flow="pilot" name="fundadores" size="lg" />
						<TypeformBoundary flow="research" name="fundadores" size="lg" label={c.surveyCta} />
					</>
				)
			}

			<p class="body-md founders__note" data-founders-note>{c.note}</p>
		</div>
	</div>
</Section>

<style>
	.founders__inner {
		display: flex;
		flex-direction: column;
		gap: var(--space-12);
	}

	.founders__head {
		display: flex;
		flex-direction: column;
		gap: var(--space-6);
	}

	.founders__heading {
		font-family: var(--font-display);
		font-size: var(--fluid-display);
		line-height: 1.04;
		letter-spacing: var(--text-display-2xl-tracking);
		font-weight: var(--text-display-2xl-weight);
		color: var(--text-primary);
		margin: 0;
		max-width: 16ch;
		text-wrap: balance;
	}

	.founders__lede {
		max-width: var(--measure);
	}

	/* Action -------------------------------------------------------------- */

	.founders__action {
		display: flex;
		flex-direction: column;
		gap: var(--space-6);
		max-width: var(--measure);
	}

	.founders__buttons {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-6) var(--space-10);
	}

	.founders__secondary {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-3) var(--space-4);
	}

	.founders__note {
		max-width: 70ch;
		padding-top: var(--space-6);
		border-top: 1px solid var(--border-hairline);
	}

	@media (min-width: 900px) {
		.founders__inner {
			gap: var(--space-16);
		}
	}
</style>
