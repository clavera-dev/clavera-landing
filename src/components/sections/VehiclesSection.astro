---
import Section from '../layout/Section.astro';
import RenderFigure from '../media/RenderFigure.astro';
import { getCopy } from '../../i18n';

const c = getCopy(Astro.currentLocale).vehicles;

/**
 * R5 (cargo and oversized bicycles) becomes the page's first true edge-to-edge
 * band. It is the render that answers "will my vehicle fit?" literally — three
 * different machines standing in marked floor bays — so it runs full width and
 * the list of what fits is set beneath it as one typographic line rather than
 * a row of tags.
 */
---

<Section
	id="vehiculos"
	index={c.index}
	railLabel={c.rail}
	eyebrow={c.eyebrow}
	heading={c.heading}
	rhythm="tight"
	divider
>
	<div class="vehicles">
		<div class="vehicles__band bleed">
			<RenderFigure
				id="r5"
				variant="cover"
				sizes="100vw"
				position="50% 55%"
				caption
			/>
		</div>

		<ul class="vehicles__list">
			{
				c.items.map((vehicle) => (
					<li class="vehicles__item">
						{vehicle}
					</li>
				))
			}
		</ul>

		<div class="vehicles__note">
			<p class="body-md" data-battery-note>{c.batteryNote}</p>
			<p class="body-md">{c.evaluatingNote}</p>
		</div>
	</div>
</Section>

<style>
	.vehicles {
		display: flex;
		flex-direction: column;
		gap: var(--space-12);
	}

	.vehicles__band {
		--figure-ratio: 16 / 10;
	}

	/* The band runs edge to edge, but its caption belongs back on the page's
	   content edge with everything else. --edge-inner/--edge measure exactly
	   that distance from each viewport edge. */
	.vehicles__band :global(figcaption) {
		padding-inline: var(--edge-inner) var(--edge);
	}

	/* One flowing line of what fits, at heading scale, separated by quiet
	   marks — the alternative to six identical pills.

	   Each mark hangs in the gap in front of its item, and the list clips
	   at its own edges. The mark in front of whichever item starts a line
	   therefore falls outside the list and is cut away, so no line ever
	   starts or ends on a separator, whatever the locale or width. The
	   items themselves never leave the list's box. */
	.vehicles__list {
		--mark: 1.3em;
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: var(--space-2) var(--mark);
		overflow: hidden;
		font-family: var(--font-display);
		/* Capped at 50px: above that the content column stops growing while
		   the type kept climbing, and the last item dropped to a line of its
		   own in English (and in Spanish from 1600px). */
		font-size: min(var(--fluid-display-sm), 50px);
		line-height: 1.25;
		letter-spacing: var(--text-display-lg-tracking);
		font-weight: 600;
		color: var(--text-primary);
	}

	.vehicles__item {
		position: relative;
	}

	.vehicles__item::before {
		content: '';
		position: absolute;
		/* Centred in the gap, on the middle of the x-height. */
		inset-inline-start: calc(var(--mark) / -2 - 0.12em);
		top: 0.45em;
		width: 0.24em;
		height: 0.24em;
		border-radius: var(--radius-pill);
		background: var(--text-tertiary);
	}

	.vehicles__note {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		max-width: 52ch;
		padding-top: var(--space-6);
		border-top: 1px solid var(--border-hairline);
	}

	/* On a phone the same list simply stacks, without marks. */
	@media (max-width: 699px) {
		.vehicles__list {
			flex-direction: column;
			align-items: flex-start;
			gap: var(--space-1);
		}

		.vehicles__item::before {
			display: none;
		}

		/* "Городской велосипед" is wider than a phone column at the 36px
		   floor and wrapped into what read as two vehicles. Russian scales
		   with the viewport here until it fits on one line. */
		:global(:root:lang(ru)) .vehicles__list {
			font-size: min(var(--fluid-display-sm), 8.2vw);
		}
	}

	@media (min-width: 900px) {
		.vehicles {
			gap: var(--space-16);
		}

		.vehicles__band {
			--figure-ratio: 2.35 / 1;
		}

		.vehicles__list {
			/* Preferred measure only. Longer locales wrap onto more lines
			   rather than overflowing or shrinking. */
			max-width: 32ch;
		}
	}
</style>
