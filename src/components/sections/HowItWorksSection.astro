---
import Section from '../layout/Section.astro';

const steps = [
	{ n: 1, title: 'Reservá tu lugar', copy: 'Dejá tus datos y contanos en qué barrio la necesitás.' },
	{
		n: 2,
		title: 'Activá tu acceso',
		copy: 'Registramos marca, modelo y número de cuadro. Recibís tu acceso personal.',
	},
	{ n: 3, title: 'Usala todos los días', copy: 'Llegás, dejás la bici en tu lugar y seguís.' },
];
---

<Section id="works" eyebrow="Cómo funciona" heading="Tres pasos, y la bici deja de ser un problema.">
	<ol class="steps">
		{
			steps.map((step) => (
				<li class="steps__item">
					<span class="steps__number">{step.n}</span>
					<div>
						<p class="heading-h4">{step.title}</p>
						<p class="body-md">{step.copy}</p>
					</div>
				</li>
			))
		}
	</ol>
</Section>

<style>
	.steps {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-6);
		counter-reset: step;
	}

	.steps__item {
		display: flex;
		gap: var(--space-4);
		align-items: flex-start;
	}

	.steps__number {
		flex: none;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		border-radius: var(--radius-pill);
		background: var(--accent-subtle);
		color: var(--accent);
		font-family: var(--font-mono);
		font-weight: 600;
	}

	@media (min-width: 900px) {
		.steps {
			grid-template-columns: repeat(3, 1fr);
		}
	}
</style>
