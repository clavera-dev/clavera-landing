---
import Section from '../layout/Section.astro';

const steps = [
	{ n: '1', title: 'Reservá tu lugar', copy: 'Dejá tus datos y contanos en qué barrio la necesitás.' },
	{
		n: '2',
		title: 'Activá tu acceso',
		copy: 'Registramos marca, modelo y número de cuadro. Recibís tu acceso personal.',
	},
	{ n: '3', title: 'Usala todos los días', copy: 'Llegás, dejás la bici en tu lugar y seguís.' },
];
---

<Section
	id="works"
	index="03"
	railLabel="Cómo funciona"
	eyebrow="Cómo funciona"
	heading="Tres pasos, y la bici deja de ser un problema."
	rhythm="tight"
>
	<ol class="steps">
		{
			steps.map((step) => (
				<li class="steps__item">
					<span class="steps__n numeral">{step.n}</span>
					<h3 class="heading-h4">{step.title}</h3>
					<p class="body-md">{step.copy}</p>
				</li>
			))
		}
	</ol>
</Section>

<style>
	/*
	  A measured rail rather than three cards: one continuous hairline runs
	  across the top of the row and each step hangs from it under an amber tick
	  — the way stations are marked on a drawing.
	*/
	.steps {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: 1fr;
	}

	.steps__item {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		padding-block: var(--space-8);
		border-top: 1px solid var(--border-hairline);
	}

	/* The tick where this step meets the rail. */
	.steps__item::before {
		content: '';
		position: absolute;
		top: -1px;
		left: 0;
		width: var(--space-10);
		height: 2px;
		background: var(--accent);
	}

	@media (max-width: 799px) {
		.steps__item:last-child {
			border-bottom: 1px solid var(--border-hairline);
		}
	}

	.steps__n {
		font-size: var(--text-display-lg-size);
		line-height: 1;
		color: var(--accent);
		margin-bottom: var(--space-2);
	}

	.steps__item .body-md {
		max-width: 40ch;
	}

	@media (min-width: 800px) {
		.steps {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			column-gap: var(--space-10);
		}

		.steps__item {
			padding-block: var(--space-10) 0;
		}

		.steps__n {
			font-size: var(--text-display-xl-size);
		}
	}

	@media (min-width: 1100px) {
		.steps {
			column-gap: var(--space-16);
		}
	}
</style>
