---
import Typeset from '../typography/Typeset.astro';
import Section from '../layout/Section.astro';

/**
 * Seven properties since the owner handoff v1.1 (2026-09-23): pillar 02
 * carries 24/7 access (§3.1) — one of only two places it may appear, both
 * under the planned-service note below — and pillar 08 ("Zona de limpieza")
 * is removed (§3.5).
 *
 * Redesign H (spec §3.4): set on the bento's asymmetric grid — two wide
 * cells, three medium, two wide — each with a linework glyph, but as cells
 * under a hairline rather than filled cards. The first build used cards; on
 * review seven bordered icon cards read as the software-template look the
 * redesign set out to remove (spec §9a), so the grid keeps its rhythm and
 * drops the boxes. The alternative (spec option B, sticky R2 beside a list)
 * stays documented in the worklog.
 *
 * R2 (vertical lifting storage systems) opens the section, running off the
 * right edge of the page. It is the render that shows the single idea the
 * whole product rests on — one numbered, independent bay per member — so it
 * introduces the list rather than sitting inside it.
 */
import RenderFigure from '../media/RenderFigure.astro';
import { getCopy } from '../../i18n';

const c = getCopy(Astro.currentLocale).solution;

/*
 * Tabler outline glyphs (the DS icon set, stroke 1.75 per the DS README),
 * inlined so `currentColor` resolves against the text colour. Keyed by the
 * pillar's position, which is the same in every locale:
 *   bike (assigned spot) · qrcode (personal digital access) ·
 *   umbrella (closed and dry) · clipboard-list (access log) ·
 *   door-exit (take yours out) · barcode (frame-number inventory) ·
 *   calendar (monthly membership).
 */
const GLYPHS: string[][] = [
	[
		'M5 18m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0',
		'M19 18m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0',
		'M12 19l0 -4l-3 -3l5 -4l2 3l3 0',
		'M17 5m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0',
	],
	[
		'M4 4m0 1a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1z',
		'M7 17l0 .01',
		'M14 4m0 1a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1z',
		'M7 7l0 .01',
		'M4 14m0 1a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1z',
		'M17 7l0 .01',
		'M14 14l3 0',
		'M20 14l0 .01',
		'M14 14l0 3',
		'M14 20l3 0',
		'M17 17l3 0',
		'M20 17l0 3',
	],
	['M4 12a8 8 0 0 1 16 0z', 'M12 12v6a2 2 0 0 0 4 0'],
	[
		'M9 5h-2a2 2 0 0 0 -2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-12a2 2 0 0 0 -2 -2h-2',
		'M9 3m0 2a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2v0a2 2 0 0 1 -2 2h-2a2 2 0 0 1 -2 -2z',
		'M9 12l.01 0',
		'M13 12l2 0',
		'M9 16l.01 0',
		'M13 16l2 0',
	],
	[
		'M13 12v.01',
		'M3 21h18',
		'M5 21v-16a2 2 0 0 1 2 -2h7.5m2.5 10.5v7.5',
		'M14 7h7m-3 -3l3 3l-3 3',
	],
	[
		'M4 7v-1a2 2 0 0 1 2 -2h2',
		'M4 17v1a2 2 0 0 0 2 2h2',
		'M16 4h2a2 2 0 0 1 2 2v1',
		'M16 20h2a2 2 0 0 0 2 -2v-1',
		'M5 11h1v2h-1z',
		'M10 11l0 2',
		'M14 11h1v2h-1z',
		'M19 11l0 2',
	],
	[
		'M4 7a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2v-12z',
		'M16 3v4',
		'M8 3v4',
		'M4 11h16',
		'M11 15h1',
		'M12 15v3',
	],
];
---

<Section
	id="solucion"
	index={c.index}
	railLabel={c.rail}
	surface="raised"
	labelledby="solucion-heading"
	rhythm="loose"
	divider
>
	<div class="solution__intro">
		<div class="solution__text">
			<p class="eyebrow">{c.eyebrow}</p>
			<h2 id="solucion-heading" class="heading-h2"><Typeset text={c.heading} /></h2>
			<p class="lede">{c.lede}</p>
			{/*
			  No hub is in operation. The properties below are written in
			  the present tense as product properties, so this line states
			  plainly that they are planned properties of the future service.
			*/}
			<p class="body-md solution__planned" data-planned-note>{c.plannedNote}</p>
		</div>

		<div class="solution__media bleed-right">
			<RenderFigure
				id="r2"
				variant="plain"
				sizes="(min-width: 900px) 60vw, 100vw"
				caption
			/>
		</div>
	</div>

	<ol class="index">
		{
			c.pillars.map((pillar, i) => (
				<li class:list={['index__row', i < 2 && 'index__row--lead']}>
					<div class="index__top">
						<svg
							class="index__glyph"
							viewBox="0 0 24 24"
							width="28"
							height="28"
							fill="none"
							stroke="currentColor"
							stroke-width="1.75"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
							focusable="false"
						>
							{(GLYPHS[i] ?? []).map((d) => <path d={d} />)}
						</svg>
						<span class="index__n">{pillar.n}</span>
					</div>
					<div class="index__text">
						<h3 class="index__title">{pillar.title}</h3>
						<p class="body-md">{pillar.copy}</p>
					</div>
				</li>
			))
		}
	</ol>
</Section>

<style>
	.solution__intro {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-10);
		margin-bottom: var(--space-16);
	}

	.solution__planned {
		color: var(--text-tertiary);
	}

	.solution__text {
		display: flex;
		flex-direction: column;
		gap: var(--space-6);
		max-width: var(--measure);
	}

	/* The bleeding image loses its right-hand radius: it is running off the
	   page, not sitting in a frame. Raised specificity: RenderFigure's own
	   radius rule otherwise wins the tie. */
	.solution__intro .solution__media :global(.render-figure picture) {
		border-start-end-radius: 0;
		border-end-end-radius: 0;
	}

	@media (min-width: 900px) {
		.solution__intro {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			gap: var(--space-16);
			/* The text column starts at the top so its eyebrow shares the rail
			   index's line; the image keeps its optical centring on its own. */
			align-items: start;
			margin-bottom: var(--space-24);
		}

		.solution__media {
			align-self: center;
		}

		/* Half a row: one step under the full-width section headings. */
		.solution__text .heading-h2 {
			font-size: var(--fluid-h2-split);
		}
	}

	/* Specification grid --------------------------------------------------- */

	/*
	  Six tracks: 3 + 3, 2 + 2 + 2, 3 + 3 from 1000px; two per row on a
	  tablet, with the seventh pillar taking the full row; one column on a
	  phone. Each pillar is a cell under a hairline — the drawing-sheet
	  language of the rest of the page — not a filled card: seven bordered
	  icon cards read as a software template, which is exactly what the
	  redesign set out to remove.
	*/
	.index {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 0 var(--space-12);
	}

	.index__row {
		display: flex;
		flex-direction: column;
		gap: var(--space-6);
		padding-block: var(--space-6) var(--space-10);
		border-top: 1px solid var(--border-hairline-strong);
	}

	.index__top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
	}

	/* Linework in the text colour: the glyph names the property, it does
	   not decorate it. Amber stays with the actions. */
	.index__glyph {
		flex: none;
		width: 24px;
		height: 24px;
		color: var(--text-secondary);
	}

	/* The pillar's own number, kept quiet: a reference, not a counter. */
	.index__n {
		font-family: var(--font-mono);
		font-size: var(--text-mono-sm-size);
		line-height: var(--text-mono-sm-line);
		letter-spacing: var(--text-mono-sm-tracking);
		font-variant-numeric: tabular-nums;
		color: var(--text-tertiary);
	}

	.index__text {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.index__title {
		font-family: var(--font-display);
		font-size: var(--text-h4-size);
		line-height: var(--text-h4-line);
		letter-spacing: var(--text-h4-tracking);
		font-weight: var(--text-h4-weight);
		color: var(--text-primary);
		margin: 0;
		text-wrap: balance;
	}

	.index__text .body-md {
		max-width: 44ch;
	}

	/* On a phone each pillar is one row — glyph, words, number — and the
	   seven read as one compact specification. */
	@media (max-width: 699px) {
		.index__row {
			display: grid;
			grid-template-columns: 24px minmax(0, 1fr) auto;
			align-items: start;
			gap: var(--space-4);
			padding-block: var(--space-5) var(--space-6);
		}

		.index__top {
			display: contents;
		}

		.index__glyph {
			grid-column: 1;
			grid-row: 1;
		}

		.index__text {
			grid-column: 2;
			grid-row: 1;
		}

		.index__n {
			grid-column: 3;
			grid-row: 1;
			padding-top: var(--space-1);
		}
	}

	@media (min-width: 700px) {
		.index {
			grid-template-columns: repeat(6, minmax(0, 1fr));
		}

		.index__row {
			grid-column: span 3;
		}

		.index__row:last-child {
			grid-column: 1 / -1;
		}

		/* The two lead pillars carry the h3 step. */
		.index__row--lead .index__title {
			font-size: var(--text-h3-size);
			line-height: var(--text-h3-line);
			letter-spacing: var(--text-h3-tracking);
		}
	}

	@media (min-width: 1000px) {
		.index__row:nth-child(3),
		.index__row:nth-child(4),
		.index__row:nth-child(5) {
			grid-column: span 2;
		}

		.index__row:last-child {
			grid-column: span 3;
		}

		.index__row--lead {
			padding-bottom: var(--space-16);
		}
	}
</style>
