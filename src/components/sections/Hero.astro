---
/**
 * The establishing shot.
 *
 * R1 (general hub overview) runs full-bleed behind the headline — the one
 * place the design system allows full-bleed photography, and the only render
 * that shows the whole space at once.
 *
 * Desktop and mobile are two different compositions, not one scaled:
 *   desktop – the image fills the viewport and the headline sits over it,
 *             bottom-left, under a functional scrim.
 *   mobile  – the image is a tall band that fades into graphite, and the
 *             headline begins below it at full display size.
 *
 * The zone selector replaces the old "Me interesa el piloto" hero button
 * (owner handoff v1.1 §3.2, §4.2); the header CTA still links to #fundadores.
 */
import ZoneSelector from '../lead-form/ZoneSelector.astro';
import { getRender, avifSrcset, webpSrcset, webpSrc } from '../../data/media';
import { getCopy, localeHome, resolveLocale, renderAlt } from '../../i18n';

const copy = getCopy(Astro.currentLocale);
const home = localeHome(resolveLocale(Astro.currentLocale));
const r1 = getRender('r1');
const { width, height } = r1.dimensions[1600];
---

<section id="top" class="hero" aria-labelledby="hero-heading">
	<figure class="hero__media">
		<picture>
			<source type="image/avif" srcset={avifSrcset(r1)} sizes="100vw" />
			<source type="image/webp" srcset={webpSrcset(r1)} sizes="100vw" />
			<img
				src={webpSrc(r1, 1600)}
				alt={renderAlt(copy, 'r1')}
				width={width}
				height={height}
				loading="eager"
				fetchpriority="high"
				decoding="async"
			/>
		</picture>
		<figcaption class="hero__disclosure">{copy.media.disclosure}</figcaption>
	</figure>

	<div class="hero__body">
		<div class="shell shell--aligned hero__inner">
			<p class="eyebrow hero__eyebrow">{copy.hero.eyebrow}</p>

			<h1 id="hero-heading" class="hero__heading">{copy.hero.headingHtml}</h1>

			<p class="lede hero__lede">{copy.hero.lede}</p>

			<ZoneSelector name="hero" />

			<div class="hero__actions">
				<a class="button button--ghost button--lg" href={`${home}#works`}>
					{copy.hero.ctaSecondary}
				</a>
			</div>

			<ul class="hero__facts">
				{copy.hero.facts.map((fact) => <li class="mono">{fact}</li>)}
			</ul>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		display: grid;
		background: var(--bg-base);
	}

	/* Media ---------------------------------------------------------------- */

	.hero__media {
		position: relative;
		grid-area: 1 / 1;
		margin: 0;
	}

	.hero__media picture {
		display: block;
		position: relative;
		height: 100%;
		overflow: hidden;
	}

	.hero__media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 42%;
	}

	/* Functional scrim: the one gradient the design system permits, present
	   only to keep the headline legible over photography. */
	.hero__media picture::after {
		content: '';
		position: absolute;
		inset: 0;
		background:
			linear-gradient(
				to top,
				oklch(15% 0.004 95) 0%,
				oklch(15% 0.004 95 / 0.97) 14%,
				oklch(15% 0.004 95 / 0.55) 38%,
				oklch(15% 0.004 95 / 0.1) 62%
			),
			linear-gradient(to bottom, oklch(15% 0.004 95 / 0.72) 0%, transparent 20%);
	}

	/* On desktop the type column also needs a lateral scrim: the render's own
	   lit wordmark falls exactly where the headline sits, and two brand marks
	   competing in the same place reads as an accident. Weighting the left of
	   the frame darker separates them and leaves the corridor depth on the
	   right fully lit. */
	@media (min-width: 900px) {
		.hero__media picture::after {
			background:
				linear-gradient(
					to right,
					oklch(15% 0.004 95 / 0.92) 0%,
					oklch(15% 0.004 95 / 0.78) 30%,
					oklch(15% 0.004 95 / 0.3) 58%,
					oklch(15% 0.004 95 / 0) 80%
				),
				linear-gradient(
					to top,
					oklch(15% 0.004 95) 0%,
					oklch(15% 0.004 95 / 0.9) 12%,
					oklch(15% 0.004 95 / 0.4) 34%,
					oklch(15% 0.004 95 / 0.05) 60%
				),
				linear-gradient(to bottom, oklch(15% 0.004 95 / 0.72) 0%, transparent 20%);
		}
	}

	.hero__disclosure {
		font-family: var(--font-mono);
		font-size: var(--text-mono-sm-size);
		line-height: var(--text-mono-sm-line);
		letter-spacing: var(--text-mono-sm-tracking);
		color: var(--text-tertiary);
		text-wrap: pretty;
	}

	/* Body ----------------------------------------------------------------- */

	.hero__body {
		grid-area: 1 / 1;
		position: relative;
		z-index: 1;
		display: flex;
		align-items: flex-end;
	}

	.hero__inner {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-6);
	}

	.hero__heading {
		font-family: var(--font-display);
		font-size: var(--fluid-display);
		line-height: 1.02;
		letter-spacing: var(--text-display-2xl-tracking);
		font-weight: var(--text-display-2xl-weight);
		color: var(--text-primary);
		margin: 0;
		/* A preferred measure, not a cap: longer locales wrap to another line
		   instead of being squeezed or clipped. */
		max-width: 15ch;
		text-wrap: balance;
	}

	/* Over photography the tertiary eyebrow colour disappears; on this one
	   section it steps up to secondary. */
	.hero__eyebrow {
		color: var(--text-secondary);
	}

	.hero__lede {
		max-width: 48ch;
		color: var(--text-secondary);
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-4);
		margin-top: var(--space-2);
	}

	/* Spec strip instead of a row of pills: rectangular, hairline-divided,
	   set in mono — the design system reserves pill radius for status badges. */
	.hero__facts {
		list-style: none;
		margin: var(--space-2) 0 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3) 0;
	}

	.hero__facts li {
		padding-inline: var(--space-5);
		border-left: 1px solid var(--border-hairline-strong);
		color: var(--text-secondary);
	}

	.hero__facts li:first-child {
		padding-left: 0;
		border-left: 0;
	}

	/* Mobile composition: a tall image band dissolving into graphite, with the
	   headline beginning below it at full display size. --------------------- */

	@media (max-width: 899px) {
		.hero {
			grid-template-rows: auto auto;
		}

		.hero__media {
			grid-area: 1 / 1;
		}

		/* Sized so the image, the headline and the primary call to action all
		   land within the first screen on a typical phone. */
		.hero__media picture {
			height: 40svh;
			min-height: 260px;
			max-height: 420px;
		}

		.hero__media picture::after {
			background: linear-gradient(
				to top,
				oklch(15% 0.004 95) 2%,
				oklch(15% 0.004 95 / 0.55) 26%,
				oklch(15% 0.004 95 / 0.04) 58%,
				oklch(15% 0.004 95 / 0.6) 100%
			);
		}

		.hero__disclosure {
			padding-inline: var(--gutter);
			padding-top: var(--space-2);
			max-width: 52ch;
		}

		.hero__body {
			grid-area: 2 / 1;
			padding-block: var(--space-6) var(--rhythm-tight);
		}

		.hero__inner {
			gap: var(--space-5);
		}
	}

	/*
	  Short phones: bring the primary call to action back above the fold.

	  Brief S1 requires the primary CTA to be visible without scrolling at
	  375×667. It was not: the image band (267px) plus the mandatory render
	  disclosure (56px) spent 323px before the first word of copy, pushing the
	  CTA to y=729 in Spanish and y=790 in Russian — 62px and 123px below the
	  fold.

	  The budget is recovered from the image band and the vertical rhythm, not
	  from the copy: no text is shortened, no body size is reduced, the
	  disclosure keeps its own line, and nothing is locale-specific — Russian is
	  the longest locale and is what this is sized against, so Spanish and
	  English clear the fold comfortably.

	  Second pass (owner handoff v1.1 §3.2): the hero's primary action moved from
	  a single button to the zone selector's heading + row, which added the
	  selector's own label line above the CTA. That pushed the Russian "Seguir"
	  bottom to 684px — still below the fold — even with the buffer above, so
	  the image band and rhythm are trimmed a little further here. The trim is
	  the same for every locale; it happens to matter most for Russian, which
	  wraps to the most lines.

	  M5.2 (H-1), decision D4 closed 2026-10-06: the owner kept this band
	  (designer image brief §4.1, "follow the recommendations"). Variant A put
	  text over the image, which is a layout change outside the pilot scope;
	  the prototype CSS and its comparison harness were removed.
	*/
	@media (max-width: 599px) and (max-height: 700px) {
		.hero__media picture {
			/* Still deliberately generous, not a knife-edge fit: with the display
			   face still loading, the fallback metrics push the Russian headline
			   onto another line, and a layout that only just cleared the fold
			   would spill during that first paint. */
			height: 17svh;
			min-height: 112px;
			max-height: 160px;
		}

		.hero__body {
			padding-block: var(--space-3) var(--rhythm-tight);
		}

		.hero__inner {
			gap: var(--space-2);
		}

		.hero__actions {
			margin-top: 0;
		}
	}

	/* On a phone the two calls to action read better as a stacked pair at full
	   width than as two differently-sized buttons on separate lines, and the
	   spec strip becomes a short stacked list — a wrapped inline row leaves a
	   stray divider at the start of its second line. */
	@media (max-width: 599px) {
		.hero__actions {
			flex-direction: column;
			align-items: stretch;
			width: 100%;
		}

		.hero__facts {
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			width: 100%;
		}

		.hero__facts li {
			padding: var(--space-3) 0;
			border-left: 0;
			border-top: 1px solid var(--border-hairline);
		}

		.hero__facts li:last-child {
			border-bottom: 1px solid var(--border-hairline);
		}
	}

	/* Desktop composition: full-viewport image, type over it. --------------- */

	@media (min-width: 900px) {
		.hero {
			min-height: min(92svh, 900px);
		}

		.hero__body {
			padding-block: calc(var(--header-h) + var(--space-16)) var(--space-24);
		}

		.hero__disclosure {
			position: absolute;
			/* Lines up with the sheet's right content edge, not the page gutter. */
			right: var(--edge-exact);
			bottom: var(--space-5);
			z-index: 1;
			max-width: 44ch;
			text-align: right;
		}

		.hero__lede {
			font-size: var(--text-body-lg-size);
			line-height: var(--text-body-lg-line);
		}
	}
</style>
