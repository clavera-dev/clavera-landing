---
/**
 * The establishing shot.
 *
 * R1 (general hub overview) runs full-bleed behind the headline — the one
 * place the design system allows full-bleed photography, and the only render
 * that shows the whole space at once.
 *
 * Desktop and mobile are two different compositions, not one scaled:
 *   desktop – the image fills the viewport and the headline sits over it,
 *             bottom-left, under a functional scrim.
 *   mobile  – the image is a tall band that fades into graphite, and the
 *             headline begins below it at full display size.
 */
import { getRender, avifSrcset, webpSrcset, webpSrc, RENDER_DISCLOSURE } from '../../data/media';

const r1 = getRender('r1');
const { width, height } = r1.dimensions[1600];

const facts = ['Lugar asignado', 'Ingreso controlado', 'Cerrado y seco'];
---

<section id="top" class="hero" aria-labelledby="hero-heading">
	<figure class="hero__media">
		<picture>
			<source type="image/avif" srcset={avifSrcset(r1)} sizes="100vw" />
			<source type="image/webp" srcset={webpSrcset(r1)} sizes="100vw" />
			<img
				src={webpSrc(r1, 1600)}
				alt={r1.alt}
				width={width}
				height={height}
				loading="eager"
				fetchpriority="high"
				decoding="async"
			/>
		</picture>
		<figcaption class="hero__disclosure">{RENDER_DISCLOSURE}</figcaption>
	</figure>

	<div class="hero__body">
		<div class="shell shell--aligned hero__inner">
			<p class="eyebrow hero__eyebrow">Guarda segura · Buenos Aires</p>

			<h1 id="hero-heading" class="hero__heading">
				Tu bici merece un lugar seguro en la ciudad.
			</h1>

			<p class="lede hero__lede">
				CLAVERA es una guardería segura de bicicletas y movilidad personal por membresía. Tu lugar
				asignado, acceso digital y vigilancia, a minutos de tu casa.
			</p>

			<div class="hero__actions">
				<a class="button button--primary button--lg" href="#fundadores">Quiero mi lugar</a>
				<a class="button button--ghost button--lg" href="#works">Ver cómo funciona</a>
			</div>

			<ul class="hero__facts">
				{facts.map((fact) => <li class="mono">{fact}</li>)}
			</ul>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		display: grid;
		background: var(--bg-base);
	}

	/* Media ---------------------------------------------------------------- */

	.hero__media {
		position: relative;
		grid-area: 1 / 1;
		margin: 0;
	}

	.hero__media picture {
		display: block;
		position: relative;
		height: 100%;
		overflow: hidden;
	}

	.hero__media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 42%;
	}

	/* Functional scrim: the one gradient the design system permits, present
	   only to keep the headline legible over photography. */
	.hero__media picture::after {
		content: '';
		position: absolute;
		inset: 0;
		background:
			linear-gradient(
				to top,
				oklch(15% 0.004 95) 0%,
				oklch(15% 0.004 95 / 0.97) 14%,
				oklch(15% 0.004 95 / 0.55) 38%,
				oklch(15% 0.004 95 / 0.1) 62%
			),
			linear-gradient(to bottom, oklch(15% 0.004 95 / 0.72) 0%, transparent 20%);
	}

	/* On desktop the type column also needs a lateral scrim: the render's own
	   lit wordmark falls exactly where the headline sits, and two brand marks
	   competing in the same place reads as an accident. Weighting the left of
	   the frame darker separates them and leaves the corridor depth on the
	   right fully lit. */
	@media (min-width: 900px) {
		.hero__media picture::after {
			background:
				linear-gradient(
					to right,
					oklch(15% 0.004 95 / 0.92) 0%,
					oklch(15% 0.004 95 / 0.78) 30%,
					oklch(15% 0.004 95 / 0.3) 58%,
					oklch(15% 0.004 95 / 0) 80%
				),
				linear-gradient(
					to top,
					oklch(15% 0.004 95) 0%,
					oklch(15% 0.004 95 / 0.9) 12%,
					oklch(15% 0.004 95 / 0.4) 34%,
					oklch(15% 0.004 95 / 0.05) 60%
				),
				linear-gradient(to bottom, oklch(15% 0.004 95 / 0.72) 0%, transparent 20%);
		}
	}

	.hero__disclosure {
		font-family: var(--font-mono);
		font-size: var(--text-mono-sm-size);
		line-height: var(--text-mono-sm-line);
		letter-spacing: var(--text-mono-sm-tracking);
		color: var(--text-tertiary);
		text-wrap: pretty;
	}

	/* Body ----------------------------------------------------------------- */

	.hero__body {
		grid-area: 1 / 1;
		position: relative;
		z-index: 1;
		display: flex;
		align-items: flex-end;
	}

	.hero__inner {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-6);
	}

	.hero__heading {
		font-family: var(--font-display);
		font-size: var(--fluid-display);
		line-height: 1.02;
		letter-spacing: var(--text-display-2xl-tracking);
		font-weight: var(--text-display-2xl-weight);
		color: var(--text-primary);
		margin: 0;
		max-width: 15ch;
		text-wrap: balance;
	}

	/* Over photography the tertiary eyebrow colour disappears; on this one
	   section it steps up to secondary. */
	.hero__eyebrow {
		color: var(--text-secondary);
	}

	.hero__lede {
		max-width: 48ch;
		color: var(--text-secondary);
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-4);
		margin-top: var(--space-2);
	}

	/* Spec strip instead of a row of pills: rectangular, hairline-divided,
	   set in mono — the design system reserves pill radius for status badges. */
	.hero__facts {
		list-style: none;
		margin: var(--space-2) 0 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3) 0;
	}

	.hero__facts li {
		padding-inline: var(--space-5);
		border-left: 1px solid var(--border-hairline-strong);
		color: var(--text-secondary);
	}

	.hero__facts li:first-child {
		padding-left: 0;
		border-left: 0;
	}

	/* Mobile composition: a tall image band dissolving into graphite, with the
	   headline beginning below it at full display size. --------------------- */

	@media (max-width: 899px) {
		.hero {
			grid-template-rows: auto auto;
		}

		.hero__media {
			grid-area: 1 / 1;
		}

		/* Sized so the image, the headline and the primary call to action all
		   land within the first screen on a typical phone. */
		.hero__media picture {
			height: 40svh;
			min-height: 260px;
			max-height: 420px;
		}

		.hero__media picture::after {
			background: linear-gradient(
				to top,
				oklch(15% 0.004 95) 2%,
				oklch(15% 0.004 95 / 0.55) 26%,
				oklch(15% 0.004 95 / 0.04) 58%,
				oklch(15% 0.004 95 / 0.6) 100%
			);
		}

		.hero__disclosure {
			padding-inline: var(--gutter);
			padding-top: var(--space-2);
			max-width: 52ch;
		}

		.hero__body {
			grid-area: 2 / 1;
			padding-block: var(--space-6) var(--rhythm-tight);
		}

		.hero__inner {
			gap: var(--space-5);
		}
	}

	/* On a phone the two calls to action read better as a stacked pair at full
	   width than as two differently-sized buttons on separate lines, and the
	   spec strip becomes a short stacked list — a wrapped inline row leaves a
	   stray divider at the start of its second line. */
	@media (max-width: 599px) {
		.hero__actions {
			flex-direction: column;
			align-items: stretch;
			width: 100%;
		}

		.hero__facts {
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			width: 100%;
		}

		.hero__facts li {
			padding: var(--space-3) 0;
			border-left: 0;
			border-top: 1px solid var(--border-hairline);
		}

		.hero__facts li:last-child {
			border-bottom: 1px solid var(--border-hairline);
		}
	}

	/* Desktop composition: full-viewport image, type over it. --------------- */

	@media (min-width: 900px) {
		.hero {
			min-height: min(92svh, 900px);
		}

		.hero__body {
			padding-block: calc(var(--header-h) + var(--space-16)) var(--space-24);
		}

		.hero__disclosure {
			position: absolute;
			/* Lines up with the sheet's right content edge, not the page gutter. */
			right: var(--edge);
			bottom: var(--space-5);
			z-index: 1;
			max-width: 44ch;
			text-align: right;
		}

		.hero__lede {
			font-size: var(--text-body-lg-size);
			line-height: var(--text-body-lg-line);
		}
	}
</style>
