---
import { logo } from '../../data/media';

const currentYear = 2026;
---

<footer class="site-footer">
	<div class="shell shell--aligned site-footer__inner">
		<div class="site-footer__top">
			<div class="site-footer__brand">
				<img src={logo.src} alt={logo.alt} width="120" height="28" />
				<p class="site-footer__claim">Infraestructura urbana de guarda para tu bici.</p>
			</div>

			<div class="site-footer__cols">
				<div class="site-footer__col">
					<p class="mono site-footer__col-title">Contacto</p>
					<ul>
						<li><a href="mailto:hola@clavera.ar">hola@clavera.ar</a></li>
						<li><a href="https://instagram.com/clavera.ar" rel="me">Instagram</a></li>
						<li><a href="https://facebook.com/clavera.ar" rel="me">Facebook</a></li>
					</ul>
				</div>

				<nav class="site-footer__col" aria-label="Para propietarios y desarrolladores">
					<p class="mono site-footer__col-title">Espacios</p>
					<ul>
						<li><a href="/espacios">Proponer un espacio</a></li>
						<li><a href="/desarrolladores">Para desarrolladores</a></li>
					</ul>
				</nav>

				<nav class="site-footer__col" aria-label="Legal">
					<p class="mono site-footer__col-title">Legal</p>
					<ul>
						<li><a href="/privacidad">Política de Privacidad</a></li>
						<li><a href="/terminos">Términos y Condiciones</a></li>
						<li><a href="/cookies">Cookies</a></li>
					</ul>
				</nav>
			</div>
		</div>

		<div class="site-footer__bottom">
			<p class="caption">© {currentYear} CLAVERA. Todos los derechos reservados.</p>
			<p class="caption">Buenos Aires, Argentina</p>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--bg-base);
		border-top: 1px solid var(--border-hairline);
	}

	.site-footer__inner {
		display: flex;
		flex-direction: column;
		gap: var(--space-12);
		padding-block: var(--rhythm-tight) var(--space-10);
	}

	.site-footer__top {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-12);
	}

	.site-footer__brand {
		display: flex;
		flex-direction: column;
		gap: var(--space-5);
	}

	.site-footer__brand img {
		height: 30px;
		width: auto;
	}

	.site-footer__claim {
		font-family: var(--font-display);
		font-size: var(--text-h4-size);
		line-height: var(--text-h4-line);
		font-weight: 500;
		color: var(--text-secondary);
		margin: 0;
		max-width: 24ch;
	}

	.site-footer__cols {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
		gap: var(--space-8);
	}

	.site-footer__col-title {
		margin-bottom: var(--space-4);
		padding-bottom: var(--space-3);
		border-bottom: 1px solid var(--border-hairline);
	}

	.site-footer__col ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}

	.site-footer__col a {
		font-family: var(--font-sans);
		font-size: var(--text-body-md-size);
		line-height: var(--text-body-md-line);
		color: var(--text-secondary);
		transition: color var(--duration-fast) var(--ease-standard);
	}

	.site-footer__col a:hover {
		color: var(--accent);
	}

	.site-footer__bottom {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: var(--space-3) var(--space-8);
		padding-top: var(--space-8);
		border-top: 1px solid var(--border-hairline);
	}

	@media (min-width: 900px) {
		.site-footer__top {
			grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr);
			gap: var(--space-16);
			align-items: start;
		}
	}
</style>
