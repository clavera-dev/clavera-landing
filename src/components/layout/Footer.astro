---
import { logo } from '../../data/media';
import { getCopy } from '../../i18n';
import { whatsappHref } from '../../config/contact';
import LanguageSwitcher from './LanguageSwitcher.astro';

const copy = getCopy(Astro.currentLocale);

/*
  INTERIM TREATMENT — footer routes that do not exist yet.

  `/privacidad`, `/terminos`, `/cookies`, `/espacios` and `/desarrolladores`
  are not built. Linking to them would put a clickable 404 in front of every
  visitor and every reviewer, so an entry whose route is absent renders as
  plain text with a "pending" note instead of as an anchor.

  This is presentation only. It does NOT discharge the obligation: the three
  legal routes remain MANDATORY blockers for real public deployment
  (PROJECT_DECISIONS.md, "Legal and publishing gates"), and no legal copy is
  invented here. Reversal is one line — add the path to AVAILABLE_ROUTES when
  the route actually ships, and the entry becomes a link again.
*/
const AVAILABLE_ROUTES = new Set<string>();

/*
  WhatsApp Business. The number has not been supplied, so `whatsappHref()`
  returns null and the entry renders as plain text — never a `wa.me` link, a
  dummy number, `href="#"` or a disabled control. Supplying the number in
  src/config/contact.ts is the only change needed to make it a real link.
*/
const whatsapp = whatsappHref();

interface FooterEntry {
	href: string;
	label: string;
}

const ownerEntries: FooterEntry[] = [
	{ href: '/espacios', label: copy.footer.proposeSpace },
	{ href: '/desarrolladores', label: copy.footer.forDevelopers },
];

const legalEntries: FooterEntry[] = [
	{ href: '/privacidad', label: copy.footer.privacy },
	{ href: '/terminos', label: copy.footer.terms },
	{ href: '/cookies', label: copy.footer.cookies },
];

const isAvailable = (entry: FooterEntry) => AVAILABLE_ROUTES.has(entry.href);
const hasAnyLink = (entries: FooterEntry[]) => entries.some(isAvailable);
const hasAnyPending = (entries: FooterEntry[]) => entries.some((entry) => !isAvailable(entry));

/*
  A landmark with nothing to navigate to is noise for a screen-reader user, so
  a column that currently has no working link is a plain container rather than
  a labelled <nav>.
*/
const OwnersTag = hasAnyLink(ownerEntries) ? 'nav' : 'div';
const LegalTag = hasAnyLink(legalEntries) ? 'nav' : 'div';
---

<footer class="site-footer">
	<div class="shell shell--aligned site-footer__inner">
		<div class="site-footer__top">
			<div class="site-footer__brand">
				<img src={logo.src} alt={logo.alt} width="89" height="20" />
				<p class="site-footer__claim">{copy.footer.claim}</p>
			</div>

			<div class="site-footer__cols">
				<div class="site-footer__col">
					<p class="mono site-footer__col-title">{copy.footer.contactTitle}</p>
					<ul>
						<li><a href="mailto:hola@clavera.ar">hola@clavera.ar</a></li>
						<li><a href="https://instagram.com/clavera.ar" rel="me">Instagram</a></li>
						<li><a href="https://facebook.com/clavera.ar" rel="me">Facebook</a></li>
						<li>
							{
								whatsapp === null ? (
									<span class="site-footer__pending-item">{copy.footer.whatsappPending}</span>
								) : (
									<a href={whatsapp} rel="me">
										WhatsApp Business
									</a>
								)
							}
						</li>
					</ul>
				</div>

				<OwnersTag
					class="site-footer__col"
					aria-label={OwnersTag === 'nav' ? copy.a11y.ownersNavLabel : undefined}
				>
					<p class="mono site-footer__col-title">{copy.footer.spacesTitle}</p>
					<ul>
						{
							ownerEntries.map((entry) => (
								<li>
									{isAvailable(entry) ? (
										<a href={entry.href}>{entry.label}</a>
									) : (
										<span class="site-footer__pending-item">{entry.label}</span>
									)}
								</li>
							))
						}
					</ul>
					{
						hasAnyPending(ownerEntries) && (
							<p class="caption site-footer__pending">{copy.footer.pendingNote}</p>
						)
					}
				</OwnersTag>

				<LegalTag
					class="site-footer__col"
					aria-label={LegalTag === 'nav' ? copy.a11y.legalNavLabel : undefined}
				>
					<p class="mono site-footer__col-title">{copy.footer.legalTitle}</p>
					<ul>
						{
							legalEntries.map((entry) => (
								<li>
									{isAvailable(entry) ? (
										<a href={entry.href}>{entry.label}</a>
									) : (
										<span class="site-footer__pending-item">{entry.label}</span>
									)}
								</li>
							))
						}
					</ul>
					{
						hasAnyPending(legalEntries) && (
							<p class="caption site-footer__pending">{copy.footer.pendingNote}</p>
						)
					}
				</LegalTag>

				<div class="site-footer__col">
					<p class="mono site-footer__col-title">{copy.footer.languageTitle}</p>
					{/* Second switcher location required by brief Part V. Wrapper is
					    owned by this component so the scoped rule matches. */}
					<div class="site-footer__lang">
						<LanguageSwitcher />
					</div>
				</div>
			</div>
		</div>

		<div class="site-footer__bottom">
			<p class="caption">{copy.footer.rights}</p>
			<p class="caption">{copy.footer.location}</p>
		</div>

		{
			copy.footer.translationNotice && (
				<p class="caption site-footer__notice" lang="es-AR">
					{copy.footer.translationNotice}
				</p>
			)
		}
	</div>
</footer>

<style>
	.site-footer {
		background: var(--bg-base);
		border-top: 1px solid var(--border-hairline);
	}

	.site-footer__inner {
		display: flex;
		flex-direction: column;
		gap: var(--space-12);
		padding-block: var(--rhythm-tight) var(--space-10);
	}

	.site-footer__top {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-12);
	}

	.site-footer__brand {
		display: flex;
		flex-direction: column;
		gap: var(--space-5);
	}

	/* align-self keeps the mark at its own intrinsic width: as a column flex
	   item it would otherwise stretch to the full column and carry a box five
	   times wider than the artwork. */
	.site-footer__brand img {
		height: 30px;
		width: auto;
		align-self: flex-start;
	}

	.site-footer__claim {
		font-family: var(--font-display);
		font-size: var(--text-h4-size);
		line-height: var(--text-h4-line);
		font-weight: 500;
		color: var(--text-secondary);
		margin: 0;
		max-width: 24ch;
	}

	.site-footer__cols {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
		gap: var(--space-8);
	}

	.site-footer__col-title {
		margin-bottom: var(--space-4);
		padding-bottom: var(--space-3);
		border-bottom: 1px solid var(--border-hairline);
	}

	.site-footer__col ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}

	.site-footer__col a {
		font-family: var(--font-sans);
		font-size: var(--text-body-md-size);
		line-height: var(--text-body-md-line);
		color: var(--text-secondary);
		transition: color var(--duration-fast) var(--ease-standard);
	}

	.site-footer__col a:hover {
		color: var(--accent);
	}

	/* Reads as inactive text rather than as a link that failed to work. */
	.site-footer__pending-item {
		font-family: var(--font-sans);
		font-size: var(--text-body-md-size);
		line-height: var(--text-body-md-line);
		color: var(--text-tertiary);
	}

	.site-footer__pending {
		margin-top: var(--space-3);
	}

	/* Spanish-primacy notice, shown only on the non-canonical locales. */
	.site-footer__notice {
		max-width: 60ch;
	}

	.site-footer__lang {
		margin-top: calc(var(--space-1) * -1);
		margin-inline-start: calc(var(--space-2) * -1);
	}

	.site-footer__bottom {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: var(--space-3) var(--space-8);
		padding-top: var(--space-8);
		border-top: 1px solid var(--border-hairline);
	}

	@media (min-width: 900px) {
		.site-footer__top {
			grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr);
			gap: var(--space-16);
			align-items: start;
		}
	}
</style>
