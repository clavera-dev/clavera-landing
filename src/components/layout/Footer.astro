---
import { logo } from '../../data/media';
import { getCopy, resolveLocale, localePath, type Locale } from '../../i18n';
import { whatsappHref, telHref, PHONE_DISPLAY } from '../../config/contact';
import {
	CONTROLLER_NOTICE_ES,
	CONTROLLER_CONTACT_ES,
	LANGUAGE_CLAUSE_ES,
} from '../../config/legal';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
	/** See LanguageSwitcher.astro — overrides the switcher's targets on non-home pages. */
	alternatePaths?: Record<Locale, string>;
}

const { alternatePaths } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const copy = getCopy(Astro.currentLocale);

/*
  INTERIM TREATMENT — footer routes that do not exist yet.

  `/espacios` and `/desarrolladores` are not built. Linking to them would put
  a clickable 404 in front of every visitor and every reviewer, so an entry
  whose route is absent renders as plain text with a "pending" note instead
  of as an anchor. Reversal is one line — add the route to AVAILABLE_ROUTES
  when it ships, and the entry becomes a link again.

  `/privacidad`, `/terminos` and `/cookies` are now built (this pass) and are
  listed as available below, at their own locale's path via `localePath`.
*/
const AVAILABLE_ROUTES = new Set<string>(['privacidad', 'terminos', 'cookies']);

/*
  WhatsApp Business. `whatsappHref()` returns the owner-supplied
  `wa.me/message` short link from src/config/contact.ts when it is present
  and well-formed, or null otherwise — in which case the entry renders as
  plain text, never a dummy `wa.me` link, `href="#"` or a disabled control.
*/
const whatsapp = whatsappHref();

/*
  Click-to-call. `telHref()` returns a `tel:` link built from the
  owner-supplied `PHONE_NUMBER` in src/config/contact.ts, or null otherwise —
  in which case the entry renders as plain text, same treatment as WhatsApp
  above. This is a distinct destination from the WhatsApp entry: it must
  never replace or merge with the `wa.me` chat link.
*/
const phone = telHref();

interface FooterEntry {
	/** Route segment, without a locale prefix — resolved via `localePath`. */
	route: string;
	label: string;
}

const ownerEntries: FooterEntry[] = [
	{ route: 'espacios', label: copy.footer.proposeSpace },
	{ route: 'desarrolladores', label: copy.footer.forDevelopers },
];

const legalEntries: FooterEntry[] = [
	{ route: 'privacidad', label: copy.footer.privacy },
	{ route: 'terminos', label: copy.footer.terms },
	{ route: 'cookies', label: copy.footer.cookies },
];

const isAvailable = (entry: FooterEntry) => AVAILABLE_ROUTES.has(entry.route);
const hasAnyLink = (entries: FooterEntry[]) => entries.some(isAvailable);
const hasAnyPending = (entries: FooterEntry[]) => entries.some((entry) => !isAvailable(entry));

/*
  A landmark with nothing to navigate to is noise for a screen-reader user, so
  a column that currently has no working link is a plain container rather than
  a labelled <nav>.
*/
const OwnersTag = hasAnyLink(ownerEntries) ? 'nav' : 'div';
const LegalTag = hasAnyLink(legalEntries) ? 'nav' : 'div';
---

<footer class="site-footer">
	<div class="shell shell--aligned site-footer__inner">
		<div class="site-footer__top">
			<div class="site-footer__brand">
				<img src={logo.src} alt={logo.alt} width="89" height="20" />
				<p class="site-footer__claim">{copy.footer.claim}</p>
			</div>

			<div class="site-footer__cols">
				<div class="site-footer__col">
					<p class="mono site-footer__col-title">{copy.footer.contactTitle}</p>
					<ul>
						<li><a href="mailto:hola@clavera.ar">hola@clavera.ar</a></li>
						<li><a href="https://instagram.com/clavera.ar" rel="me">Instagram</a></li>
						<li><a href="https://facebook.com/clavera.ar" rel="me">Facebook</a></li>
						<li><a href="https://www.tiktok.com/@clavera.ar" rel="me">TikTok</a></li>
						<li>
							{
								whatsapp === null ? (
									<span class="site-footer__pending-item">{copy.footer.whatsappPending}</span>
								) : (
									<a href={whatsapp} rel="me">
										WhatsApp Business
									</a>
								)
							}
						</li>
						<li>
							{
								phone === null ? (
									<span class="site-footer__pending-item">{copy.footer.phonePending}</span>
								) : (
									<a href={phone}>{PHONE_DISPLAY}</a>
								)
							}
						</li>
					</ul>
				</div>

				<OwnersTag
					class="site-footer__col"
					aria-label={OwnersTag === 'nav' ? copy.a11y.ownersNavLabel : undefined}
				>
					<p class="mono site-footer__col-title">{copy.footer.spacesTitle}</p>
					<ul>
						{
							ownerEntries.map((entry) => (
								<li>
									{isAvailable(entry) ? (
										<a href={localePath(locale, entry.route)}>{entry.label}</a>
									) : (
										<span class="site-footer__pending-item">{entry.label}</span>
									)}
								</li>
							))
						}
					</ul>
					{
						hasAnyPending(ownerEntries) && (
							<p class="caption site-footer__pending">{copy.footer.pendingNote}</p>
						)
					}
				</OwnersTag>

				<LegalTag
					class="site-footer__col"
					aria-label={LegalTag === 'nav' ? copy.a11y.legalNavLabel : undefined}
				>
					<p class="mono site-footer__col-title">{copy.footer.legalTitle}</p>
					<ul>
						{
							legalEntries.map((entry) => (
								<li>
									{isAvailable(entry) ? (
										<a href={localePath(locale, entry.route)}>{entry.label}</a>
									) : (
										<span class="site-footer__pending-item">{entry.label}</span>
									)}
								</li>
							))
						}
					</ul>
					{
						hasAnyPending(legalEntries) && (
							<p class="caption site-footer__pending">{copy.footer.pendingNote}</p>
						)
					}
				</LegalTag>

				<div class="site-footer__col">
					<p class="mono site-footer__col-title">{copy.footer.languageTitle}</p>
					{/* Second switcher location required by brief Part V. Wrapper is
					    owned by this component so the scoped rule matches. */}
					<div class="site-footer__lang">
						<LanguageSwitcher paths={alternatePaths} />
					</div>
				</div>
			</div>
		</div>

		<div class="site-footer__bottom">
			<p class="caption">{copy.footer.rights}</p>
			<p class="caption">{copy.footer.location}</p>
		</div>

		{/*
		  Controller formula and language clause, verbatim from the owner handoff
		  v1.1 B2, in Spanish on every locale. The full legal pages are now built
		  (src/components/legal/LegalPage.astro) — this footer notice stays as its
		  own always-visible summary, per B2, independent of whether a visitor
		  follows the links above.
		*/}
		<div class="site-footer__notice" lang="es-AR" data-controller-notice>
			<p class="caption">{CONTROLLER_NOTICE_ES}</p>
			<p class="caption">{CONTROLLER_CONTACT_ES}</p>
			<p class="caption" data-language-clause>{LANGUAGE_CLAUSE_ES}</p>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--bg-base);
		border-top: 1px solid var(--border-hairline);
	}

	.site-footer__inner {
		display: flex;
		flex-direction: column;
		gap: var(--space-12);
		padding-block: var(--rhythm-tight) var(--space-10);
	}

	.site-footer__top {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-12);
	}

	.site-footer__brand {
		display: flex;
		flex-direction: column;
		gap: var(--space-5);
	}

	/* align-self keeps the mark at its own intrinsic width: as a column flex
	   item it would otherwise stretch to the full column and carry a box five
	   times wider than the artwork. */
	.site-footer__brand img {
		height: 30px;
		width: auto;
		align-self: flex-start;
	}

	.site-footer__claim {
		font-family: var(--font-display);
		font-size: var(--text-h4-size);
		line-height: var(--text-h4-line);
		font-weight: 500;
		color: var(--text-secondary);
		margin: 0;
		max-width: 24ch;
	}

	.site-footer__cols {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
		gap: var(--space-8);
	}

	.site-footer__col-title {
		margin-bottom: var(--space-4);
		padding-bottom: var(--space-3);
		border-bottom: 1px solid var(--border-hairline);
	}

	.site-footer__col ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}

	.site-footer__col a {
		font-family: var(--font-sans);
		font-size: var(--text-body-md-size);
		line-height: var(--text-body-md-line);
		color: var(--text-secondary);
		transition: color var(--duration-fast) var(--ease-standard);
	}

	.site-footer__col a:hover {
		color: var(--accent);
	}

	/* Reads as inactive text rather than as a link that failed to work. */
	.site-footer__pending-item {
		font-family: var(--font-sans);
		font-size: var(--text-body-md-size);
		line-height: var(--text-body-md-line);
		color: var(--text-tertiary);
	}

	.site-footer__pending {
		margin-top: var(--space-3);
	}

	/* Controller formula and Spanish-primacy clause, on every locale. */
	.site-footer__notice {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		max-width: 72ch;
	}

	.site-footer__lang {
		margin-top: calc(var(--space-1) * -1);
		margin-inline-start: calc(var(--space-2) * -1);
	}

	.site-footer__bottom {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: var(--space-3) var(--space-8);
		padding-top: var(--space-8);
		border-top: 1px solid var(--border-hairline);
	}

	@media (min-width: 900px) {
		.site-footer__top {
			grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr);
			gap: var(--space-16);
			align-items: start;
		}
	}
</style>
