---
import { logo } from '../../data/media';
import { getCopy } from '../../i18n';
import LanguageSwitcher from './LanguageSwitcher.astro';

const copy = getCopy(Astro.currentLocale);
---

<footer class="site-footer">
	<div class="shell shell--aligned site-footer__inner">
		<div class="site-footer__top">
			<div class="site-footer__brand">
				<img src={logo.src} alt={logo.alt} width="89" height="20" />
				<p class="site-footer__claim">{copy.footer.claim}</p>
			</div>

			<div class="site-footer__cols">
				<div class="site-footer__col">
					<p class="mono site-footer__col-title">{copy.footer.contactTitle}</p>
					<ul>
						<li><a href="mailto:hola@clavera.ar">hola@clavera.ar</a></li>
						<li><a href="https://instagram.com/clavera.ar" rel="me">Instagram</a></li>
						<li><a href="https://facebook.com/clavera.ar" rel="me">Facebook</a></li>
					</ul>
				</div>

				<nav class="site-footer__col" aria-label={copy.a11y.ownersNavLabel}>
					<p class="mono site-footer__col-title">{copy.footer.spacesTitle}</p>
					<ul>
						<li><a href="/espacios">{copy.footer.proposeSpace}</a></li>
						<li><a href="/desarrolladores">{copy.footer.forDevelopers}</a></li>
					</ul>
				</nav>

				<nav class="site-footer__col" aria-label={copy.a11y.legalNavLabel}>
					<p class="mono site-footer__col-title">{copy.footer.legalTitle}</p>
					<ul>
						<li><a href="/privacidad">{copy.footer.privacy}</a></li>
						<li><a href="/terminos">{copy.footer.terms}</a></li>
						<li><a href="/cookies">{copy.footer.cookies}</a></li>
					</ul>
				</nav>

				<div class="site-footer__col">
					<p class="mono site-footer__col-title">{copy.footer.languageTitle}</p>
					{/* Second switcher location required by brief Part V. Wrapper is
					    owned by this component so the scoped rule matches. */}
					<div class="site-footer__lang">
						<LanguageSwitcher />
					</div>
				</div>
			</div>
		</div>

		<div class="site-footer__bottom">
			<p class="caption">{copy.footer.rights}</p>
			<p class="caption">{copy.footer.location}</p>
		</div>

		{
			copy.footer.translationNotice && (
				<p class="caption site-footer__notice" lang="es-AR">
					{copy.footer.translationNotice}
				</p>
			)
		}
	</div>
</footer>

<style>
	.site-footer {
		background: var(--bg-base);
		border-top: 1px solid var(--border-hairline);
	}

	.site-footer__inner {
		display: flex;
		flex-direction: column;
		gap: var(--space-12);
		padding-block: var(--rhythm-tight) var(--space-10);
	}

	.site-footer__top {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-12);
	}

	.site-footer__brand {
		display: flex;
		flex-direction: column;
		gap: var(--space-5);
	}

	/* align-self keeps the mark at its own intrinsic width: as a column flex
	   item it would otherwise stretch to the full column and carry a box five
	   times wider than the artwork. */
	.site-footer__brand img {
		height: 30px;
		width: auto;
		align-self: flex-start;
	}

	.site-footer__claim {
		font-family: var(--font-display);
		font-size: var(--text-h4-size);
		line-height: var(--text-h4-line);
		font-weight: 500;
		color: var(--text-secondary);
		margin: 0;
		max-width: 24ch;
	}

	.site-footer__cols {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
		gap: var(--space-8);
	}

	.site-footer__col-title {
		margin-bottom: var(--space-4);
		padding-bottom: var(--space-3);
		border-bottom: 1px solid var(--border-hairline);
	}

	.site-footer__col ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}

	.site-footer__col a {
		font-family: var(--font-sans);
		font-size: var(--text-body-md-size);
		line-height: var(--text-body-md-line);
		color: var(--text-secondary);
		transition: color var(--duration-fast) var(--ease-standard);
	}

	.site-footer__col a:hover {
		color: var(--accent);
	}

	/* Spanish-primacy notice, shown only on the non-canonical locales. */
	.site-footer__notice {
		max-width: 60ch;
	}

	.site-footer__lang {
		margin-top: calc(var(--space-1) * -1);
		margin-inline-start: calc(var(--space-2) * -1);
	}

	.site-footer__bottom {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: var(--space-3) var(--space-8);
		padding-top: var(--space-8);
		border-top: 1px solid var(--border-hairline);
	}

	@media (min-width: 900px) {
		.site-footer__top {
			grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr);
			gap: var(--space-16);
			align-items: start;
		}
	}
</style>
